R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=sosotime-images
R2_PUBLIC_BASE_URL=https://images.sosotime.com

# Optional: maximum source image download size in bytes. Default is 12582912.
IMAGE_MAX_BYTES=12582912

# Optional: WebP optimization defaults.
IMAGE_WIDTH=1200
IMAGE_HEIGHT=675
IMAGE_WEBP_QUALITY=80
IMAGE_RESIZE_FIT=cover

# Optional: keep converted .webp files under .tmp/images for review.
KEEP_IMAGE_TMP=0

# Optional: Google AdSense publisher client used in generated pages.
ADSENSE_CLIENT=ca-pub-5804969457082424
