# 공공데이터포털 일반 인증키 중 Decoding 값을 넣으세요.
PUBLIC_DATA_SERVICE_KEY=

# API마다 인증키가 다르면 아래 값을 개별로 넣으세요. 비워두면 PUBLIC_DATA_SERVICE_KEY를 사용합니다.
PUBLIC_DATA_CENTRAL_WELFARE_KEY=
PUBLIC_DATA_LOCAL_WELFARE_KEY=
PUBLIC_DATA_FACILITY_KEY=
PUBLIC_DATA_POPULATION_KEY=

# 공공데이터포털 상세 화면의 요청주소를 그대로 넣으면 됩니다.
PUBLIC_DATA_CENTRAL_WELFARE_LIST_URL=
PUBLIC_DATA_CENTRAL_WELFARE_DETAIL_URL=
PUBLIC_DATA_LOCAL_WELFARE_LIST_URL=
PUBLIC_DATA_LOCAL_WELFARE_DETAIL_URL=
PUBLIC_DATA_FACILITY_LIST_URL=
PUBLIC_DATA_FACILITY_DETAIL_URL=
PUBLIC_DATA_POPULATION_URL=

# API별 인증키 파라미터명이 다를 때만 수정하세요. 보통 serviceKey 또는 ServiceKey입니다.
PUBLIC_DATA_SERVICE_KEY_PARAM=serviceKey

# Cloudflare R2 image pipeline
# R2 upload uses the S3-compatible endpoint:
# https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public image host connected to the bucket, for example:
# https://images.bokjicheck.co.kr
R2_PUBLIC_BASE_URL=

# Optional image pipeline settings
IMAGE_SOURCE_FILE=src/data/image-sources.json
IMAGE_MANIFEST_FILE=public/image-manifest.json
IMAGE_R2_PREFIX=site-images
IMAGE_WEBP_QUALITY=80
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_DOWNLOAD_BYTES=26214400
IMAGE_FETCH_TIMEOUT_MS=20000
IMAGE_USER_AGENT=BokjiCheckImagePipeline/1.0 (+https://bokjicheck.co.kr)
