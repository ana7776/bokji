---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdSenseSlot from "@/components/AdSenseSlot.astro";
import CheckCard from "@/components/CheckCard.astro";
import PostCard from "@/components/PostCard.astro";
import PublicServiceCard from "@/components/PublicServiceCard.astro";
import { siteConfig } from "@/config/site";
import { absoluteUrl, checkItems, itemPath, relatedItems } from "@/lib/items";
import { relatedPostsForTags } from "@/lib/info";
import { relatedPublicServices } from "@/lib/publicServices";
import NetPayMonthly from "@/components/calculators/NetPayMonthly.astro";
import NetPayAnnual from "@/components/calculators/NetPayAnnual.astro";
import SocialInsurance from "@/components/calculators/SocialInsurance.astro";
import SeverancePay from "@/components/calculators/SeverancePay.astro";
import UnemploymentBenefit from "@/components/calculators/UnemploymentBenefit.astro";
import WeeklyHolidayPay from "@/components/calculators/WeeklyHolidayPay.astro";
import MinimumWageMonthly from "@/components/calculators/MinimumWageMonthly.astro";
import AnnualLeavePay from "@/components/calculators/AnnualLeavePay.astro";
import Vat from "@/components/calculators/Vat.astro";
import GlobalIncomeTax from "@/components/calculators/GlobalIncomeTax.astro";
import DepositInterest from "@/components/calculators/DepositInterest.astro";
import SavingsInterest from "@/components/calculators/SavingsInterest.astro";
import LoanInterest from "@/components/calculators/LoanInterest.astro";
import JeonseLoanInterest from "@/components/calculators/JeonseLoanInterest.astro";
import AcquisitionTax from "@/components/calculators/AcquisitionTax.astro";
import BrokerageFee from "@/components/calculators/BrokerageFee.astro";
import AreaConverter from "@/components/calculators/AreaConverter.astro";
import ElectricityBill from "@/components/calculators/ElectricityBill.astro";
import TelecomSavings from "@/components/calculators/TelecomSavings.astro";

// 도구 ID → 전용 계산기 컴포넌트 (2026년 기준 실계산 로직)
const calculatorComponents: Record<string, (props: Record<string, never>) => unknown> = {
  "monthly-salary-net-pay": NetPayMonthly,
  "annual-salary-net-pay": NetPayAnnual,
  "social-insurance": SocialInsurance,
  "severance-pay": SeverancePay,
  "unemployment-benefit": UnemploymentBenefit,
  "weekly-holiday-pay": WeeklyHolidayPay,
  "minimum-wage-monthly": MinimumWageMonthly,
  "annual-leave-pay": AnnualLeavePay,
  vat: Vat,
  "global-income-tax-simple": GlobalIncomeTax,
  "deposit-interest": DepositInterest,
  "installment-savings-interest": SavingsInterest,
  "loan-interest": LoanInterest,
  "jeonse-loan-interest": JeonseLoanInterest,
  "acquisition-tax": AcquisitionTax,
  "brokerage-fee": BrokerageFee,
  "area-converter": AreaConverter,
  "electricity-bill": ElectricityBill,
  "telecom-savings": TelecomSavings,
};

export function getStaticPaths() {
  return checkItems.map((item) => ({
    params: {
      category: item.category,
      subCategory: item.subCategory,
      id: item.id,
    },
    props: { item },
  }));
}

const { item } = Astro.props;
const DedicatedCalculator = calculatorComponents[item.id];
const posts = await getCollection("info");
const relatedPosts = relatedPostsForTags(posts, item.relatedTags, 4);
const moreItems = relatedItems(item, 4);
const publicRelated = relatedPublicServices(item, 6);
const retirementHubIds = [
  "annual-leave-pay",
  "unemployment-benefit",
  "monthly-salary-net-pay",
  "social-insurance",
  "annual-salary-net-pay",
  "loan-interest",
];
const retirementHubItems = retirementHubIds
  .map((id) => checkItems.find((candidate) => candidate.id === id))
  .filter((candidate): candidate is NonNullable<typeof candidate> => Boolean(candidate));
const officialRetirementCalculator = item.sourceReferences?.find((source) =>
  source.url.includes("moel.go.kr/retirementpayCal.do"),
);
const salaryHubIds = [
  "monthly-salary-net-pay",
  "social-insurance",
  "severance-pay",
  "annual-leave-pay",
  "loan-interest",
  "work-incentive-income-check",
];
const salaryHubItems = salaryHubIds
  .map((id) => checkItems.find((candidate) => candidate.id === id))
  .filter((candidate): candidate is NonNullable<typeof candidate> => Boolean(candidate));
const path = itemPath(item);
const primaryUseCase = item.useCases?.[0] ?? `${item.title}로 신청 전 기준 금액과 비율을 빠르게 확인할 때 사용합니다.`;
const primaryInput = item.inputGuide?.[0]
  ? `${item.inputGuide[0][0]}: ${item.inputGuide[0][1]}`
  : "계산기에 표시된 기본 금액과 비율을 본인 상황에 맞게 바꿔 입력합니다.";
const exampleRows = item.summary.slice(0, 2);
const primarySource = item.sourceReferences?.[0];
const detailJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: item.title,
    description: item.description,
    url: absoluteUrl(path),
    applicationCategory: "FinanceApplication",
    operatingSystem: "Web",
    inLanguage: "ko-KR",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "KRW",
    },
    publisher: {
      "@type": "Organization",
      name: siteConfig.publisher,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "홈", item: siteConfig.domain },
      { "@type": "ListItem", position: 2, name: "복지 체크도구", item: absoluteUrl("/check/") },
      { "@type": "ListItem", position: 3, name: item.categoryLabel, item: absoluteUrl(`/check/${item.category}/`) },
      { "@type": "ListItem", position: 4, name: item.subCategoryLabel, item: absoluteUrl(`/check/${item.category}/${item.subCategory}/`) },
      { "@type": "ListItem", position: 5, name: item.title, item: absoluteUrl(path) },
    ],
  },
  ...(item.faq
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: item.faq.map(([question, answer]) => ({
            "@type": "Question",
            name: question,
            acceptedAnswer: {
              "@type": "Answer",
              text: answer,
            },
          })),
        },
      ]
    : []),
];
---

<BaseLayout title={`${item.title} | 복지체크`} description={item.description} canonicalPath={path} jsonLd={detailJsonLd}>
  <article class="detail">
    <p class="eyebrow">{item.categoryLabel} · {item.subCategoryLabel}</p>
    <h1>{item.title}</h1>
    <p class="lead">{item.description}</p>

    <AdSenseSlot slot="check-top" label="상단 광고" />

    {
      item.id === "severance-pay" && officialRetirementCalculator && (
        <section class="section retirement-hub" aria-labelledby="retirement-hub-title">
          <div>
            <p class="hub-kicker">공식 계산기를 먼저 확인하세요</p>
            <h2 id="retirement-hub-title">고용노동부 퇴직금 계산기를 기준으로 퇴직 전 정산을 점검하세요</h2>
            <p>
              입사일자, 퇴직일자, 미산입기간, 근무제외기간, 퇴직 전 3개월 임금, 연간상여금,
              연차수당을 넣어 공식 계산 흐름을 확인한 뒤 아래 관련 계산기로 생활자금 공백을 함께 점검할 수 있습니다.
            </p>
          </div>
          <a class="official-link" href={officialRetirementCalculator.url} target="_blank" rel="nofollow noopener">
            고용노동부 퇴직금 계산기 열기
          </a>
        </section>
      )
    }

    <section class="section content">
      <h2>핵심 요약</h2>
      <table>
        <tbody>
          {item.summary.map(([name, value]) => (
            <tr>
              <th scope="row">{name}</th>
              <td>{value}</td>
            </tr>
          ))}
          <tr>
            <th scope="row">계산식</th>
            <td>{item.formula}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="section content">
      <h2>이 계산기 사용법</h2>
      <ol class="usage-steps">
        <li>
          <strong>필요한 상황</strong>
          <span>{primaryUseCase}</span>
        </li>
        <li>
          <strong>입력값 정의</strong>
          <span>{primaryInput}</span>
        </li>
        <li>
          <strong>계산식</strong>
          <span>{item.formula}</span>
        </li>
        <li>
          <strong>예시 확인</strong>
          <span>
            {exampleRows.length > 0
              ? exampleRows.map(([name, value]) => `${name}: ${value}`).join(" / ")
              : "기본값을 입력한 뒤 결과 영역에서 예상 금액을 확인합니다."}
          </span>
        </li>
        <li>
          <strong>공식 확인</strong>
          <span>
            {primarySource
              ? `${primarySource.label} 등 공식 자료에서 최종 기준을 다시 확인하세요.`
              : "최종 자격과 금액은 신청 기관 또는 공식 안내 페이지에서 다시 확인하세요."}
          </span>
        </li>
      </ol>
    </section>

    {
      item.inputGuide && (
        <section class="section content">
          <h2>입력 항목 안내</h2>
          <table>
            <tbody>
              {item.inputGuide.map(([name, value]) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      item.deductionGuide && (
        <section class="section content">
          <h2>공제 항목 기준</h2>
          <table>
            <tbody>
              {item.deductionGuide.map(([name, value]) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      item.useCases && (
        <section class="section content">
          <h2>언제 확인하면 좋을까</h2>
          <ul>
            {item.useCases.map((useCase) => <li>{useCase}</li>)}
          </ul>
        </section>
      )
    }

    {
      item.calculationStandards && (
        <section class="section content">
          <h2>계산 전에 확인할 기준</h2>
          <table>
            <tbody>
              {item.calculationStandards.map(([name, value]) => (
                <tr>
                  <th scope="row">{name}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      item.id === "median-income-threshold" ? (
        <section class="section calculator calculator-wide" data-calculator={item.id}>
          <h2>2026 기준 중위소득 빠른 계산</h2>
          <div class="calculator-grid">
            <label>
              가구원 수
              <select data-household>
                <option value="1">1인 가구</option>
                <option value="2">2인 가구</option>
                <option value="3">3인 가구</option>
                <option value="4" selected>4인 가구</option>
                <option value="5">5인 가구</option>
                <option value="6">6인 가구</option>
              </select>
            </label>
            <label>
              비교 비율
              <select data-preset-rate>
                <option value="32">생계급여 32%</option>
                <option value="40">의료급여 40%</option>
                <option value="48">주거급여 48%</option>
                <option value="50">교육급여·차상위 50%</option>
                <option value="75">긴급복지 참고 75%</option>
                <option value="100" selected>기준 중위소득 100%</option>
                <option value="120">120%</option>
                <option value="150">150%</option>
                <option value="180">180%</option>
                <option value="200">200%</option>
              </select>
            </label>
            <label>
              직접 입력 비율(%)
              <input type="number" inputmode="decimal" min="0" step="0.1" value="100" data-rate />
            </label>
          </div>
          <output data-result>입력값을 기준으로 예상 금액을 표시합니다.</output>
          <div class="threshold-table" data-threshold-table></div>
          <p>선택한 가구원 수의 2026년 기준 중위소득에 비율을 곱해 월 기준액을 계산합니다.</p>
          <p class="calculator-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
        </section>
      ) : item.id === "basic-livelihood-income-simulator" ? (
        <section class="section calculator calculator-wide" data-calculator={item.id}>
          <h2>소득인정액 상담 준비 시뮬레이터</h2>
          <div class="calculator-grid">
            <label>가구원 수<select data-household><option value="1">1인 가구</option><option value="2">2인 가구</option><option value="3">3인 가구</option><option value="4" selected>4인 가구</option><option value="5">5인 가구</option><option value="6">6인 가구</option></select></label>
            <label>거주 지역<select data-region><option value="seoul">서울</option><option value="gyeonggi">경기</option><option value="metro">광역·세종·창원</option><option value="other" selected>그 외 지역</option></select></label>
            <label>근로·사업소득 공제<select data-earned-deduction><option value="30" selected>기본 30% 간편 적용</option><option value="0">공제 없이 보기</option></select></label>
            <label>근로소득 유형 메모<select data-work-income-type><option value="none" selected>일반 근로·사업소득</option><option value="rehab">장애·정신질환 직업재활 참여소득</option><option value="young">29세 이하 수급권자·대학생</option><option value="single-parent-youth">24세 이하 한부모·청소년</option><option value="protected-youth">보호종료·가정위탁보호 종료 청년</option><option value="student">25세 이상 초·중·고등학생</option><option value="disabled-north">등록장애인·북한이탈주민</option><option value="senior">65세 이상 노인</option><option value="pregnancy">임신·분만 후 6개월 미만</option><option value="service">사회복무요원·상근예비역</option><option value="intern">공공 행정인턴 참여소득</option></select></label>
            <label>의료급여 부양의무자 점검<select data-medical-supporter><option value="unknown" selected>상담 때 확인 필요</option><option value="low">문제 가능성 낮음</option><option value="check">소득·재산 확인 필요</option></select></label>
            <label>근로소득(월)<input type="number" inputmode="numeric" min="0" value="1800000" data-earned-income /></label>
            <label>사업소득(월)<input type="number" inputmode="numeric" min="0" value="0" data-business-income /></label>
            <label>기타소득(월)<input type="number" inputmode="numeric" min="0" value="0" data-other-income /></label>
            <label>가구특성 지출(월)<input type="number" inputmode="numeric" min="0" value="0" data-expense /></label>
            <label>주거용재산(만원)<input type="number" inputmode="numeric" min="0" value="5000" data-housing-asset /></label>
            <label>일반재산(만원)<input type="number" inputmode="numeric" min="0" value="0" data-general-asset /></label>
            <label>금융재산(만원)<input type="number" inputmode="numeric" min="0" value="300" data-financial-asset /></label>
            <label>부채(만원)<input type="number" inputmode="numeric" min="0" value="0" data-debt /></label>
            <label>자동차 처리<select data-car-mode><option value="0" selected>없음 또는 면제</option><option value="0.5">간편 50% 적용</option><option value="1">일반 100% 적용</option></select></label>
            <label>차량가액(만원)<input type="number" inputmode="numeric" min="0" value="0" data-car-asset /></label>
          </div>
          <output data-result>입력값을 기준으로 예상 금액을 표시합니다.</output>
          <div class="threshold-table" data-simulator-summary></div>
          <div class="threshold-table" data-threshold-table></div>
          <p>상담 전 누락 항목을 찾기 위한 간편 추정입니다. 근로소득 특례, 자동차 예외, 금융재산 세부 공제, 의료급여 부양의무자 기준은 공식 상담에서 다시 확인하세요.</p>
          <p class="calculator-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
        </section>
      ) : item.id === "basic-livelihood-benefit-estimator" ? (
        <section class="section calculator calculator-wide" data-calculator={item.id}>
          <h2>기초생활 급여별 결과 해석기</h2>
          <div class="calculator-grid">
            <label>가구원 수<select data-household><option value="1">1인 가구</option><option value="2">2인 가구</option><option value="3">3인 가구</option><option value="4" selected>4인 가구</option><option value="5">5인 가구</option><option value="6">6인 가구</option></select></label>
            <label>소득인정액(월)<input type="number" inputmode="numeric" min="0" value="1600000" data-benefit-income /></label>
            <label>의료급여용 소득인정액(월)<input type="number" inputmode="numeric" min="0" value="1600000" data-benefit-medical-income /></label>
            <label>거주 지역<select data-benefit-region><option value="seoul">서울</option><option value="metro">경기·인천</option><option value="city">광역·세종·특례시</option><option value="other" selected>그 외 지역</option></select></label>
            <label>주거 형태<select data-benefit-housing-type><option value="rent" selected>월세</option><option value="jeonse">전세</option><option value="own">자가</option></select></label>
            <label>전세·월세 보증금(만원)<input type="number" inputmode="numeric" min="0" value="1000" data-benefit-deposit /></label>
            <label>월세(월)<input type="number" inputmode="numeric" min="0" value="350000" data-benefit-monthly-rent /></label>
            <label>초·중·고 학생 수<input type="number" inputmode="numeric" min="0" value="0" data-benefit-students /></label>
            <label>한부모가족 여부<select data-benefit-single-parent><option value="no" selected>해당 없음</option><option value="yes">해당</option></select></label>
          </div>
          <output data-result>입력값을 기준으로 예상 금액을 표시합니다.</output>
          <div class="threshold-table" data-simulator-summary></div>
          <div class="threshold-table" data-threshold-table></div>
          <p>이미 계산한 소득인정액을 급여별 기준과 비교하는 용도입니다. 실제 지급액은 행정조사와 개별 조건에 따라 달라질 수 있습니다.</p>
          <p class="calculator-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
        </section>
      ) : item.id === "basic-pension-income-simulator" ? (
        <section class="section calculator calculator-wide" data-calculator={item.id}>
          <h2>기초연금 소득인정액 사전 점검</h2>
          <div class="calculator-grid">
            <label>가구 유형<select data-pension-household><option value="single" selected>단독가구</option><option value="couple">부부가구</option></select></label>
            <label>재산 공제 지역<select data-pension-region><option value="large" selected>대도시·특례시</option><option value="medium">중소도시·세종</option><option value="rural">농어촌</option></select></label>
            <label>근로소득(월)<input type="number" inputmode="numeric" min="0" value="1800000" data-pension-earned /></label>
            <label>사업·임대소득(월)<input type="number" inputmode="numeric" min="0" value="0" data-pension-business /></label>
            <label>국민연금 등 공적연금(월)<input type="number" inputmode="numeric" min="0" value="600000" data-pension-public /></label>
            <label>이자·민간연금·무료임차소득(월)<input type="number" inputmode="numeric" min="0" value="0" data-pension-other /></label>
            <label>일반재산(만원)<input type="number" inputmode="numeric" min="0" value="12000" data-pension-general-asset /></label>
            <label>금융재산(만원)<input type="number" inputmode="numeric" min="0" value="3000" data-pension-financial-asset /></label>
            <label>부채(만원)<input type="number" inputmode="numeric" min="0" value="0" data-pension-debt /></label>
            <label>고급자동차·회원권(만원)<input type="number" inputmode="numeric" min="0" value="0" data-pension-luxury /></label>
          </div>
          <output data-result>입력값을 기준으로 예상 금액을 표시합니다.</output>
          <div class="threshold-table" data-simulator-summary></div>
          <div class="threshold-table" data-threshold-table></div>
          <p>기초연금은 기초생활보장과 산식이 다릅니다. 복지로 또는 국민연금공단 모의계산으로 최종 확인하세요.</p>
          <p class="calculator-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
        </section>
      ) : item.id === "freelancer-tax-3-3" ? (
        <section class="section calculator calculator-wide" data-calculator={item.id}>
          <h2>프리랜서 3.3% 원천징수 소득 정리</h2>
          <div class="calculator-grid">
            <label>
              계산 방식
              <select data-freelance-mode>
                <option value="gross" selected>계약금액으로 실수령액 보기</option>
                <option value="net">입금액으로 세전금액 역산</option>
              </select>
            </label>
            <label>
              입력 금액
              <input type="number" inputmode="numeric" min="0" value="1000000" data-freelance-amount />
            </label>
            <label>
              월 평균 반영 개월 수
              <input type="number" inputmode="numeric" min="1" max="12" value="3" data-freelance-months />
            </label>
          </div>
          <output data-result>입력값을 기준으로 예상 금액을 표시합니다.</output>
          <div class="threshold-table" data-simulator-summary></div>
          <p>
            소득세 3%와 지방소득세 0.3%를 나누어 보여주고, 복지 상담 전에 세전 지급액·실입금액·월평균을 함께 정리합니다.
          </p>
          <p class="calculator-warning">원천징수는 최종 세액 확정이 아니며, 종합소득세 신고와 복지 심사 결과는 달라질 수 있습니다.</p>
        </section>
      ) : DedicatedCalculator ? (
        <DedicatedCalculator />
      ) : (
        <section class="section calculator" data-calculator={item.id}>
          <h2>간편 계산</h2>
          <label>
            기준 금액
            <input type="number" inputmode="numeric" min="0" value="3000000" data-amount />
          </label>
          <label>
            비율 또는 금리(%)
            <input type="number" inputmode="decimal" min="0" step="0.1" value="3.3" data-rate />
          </label>
          <output data-result>입력값을 기준으로 예상 금액을 표시합니다.</output>
          <p>이 계산기는 신청 전 기준 금액과 비율을 빠르게 대입해 보는 간편 계산 도구입니다. 입력값 정의, 계산식, 확인해야 할 공식 경로는 위 표와 관련 안내를 함께 참고하세요.</p>
          <p class="calculator-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
        </section>
      )
    }

    {
      item.checkNotes && (
        <section class="section content">
          <h2>복지 신청 전 확인할 점</h2>
          <ul>
            {item.checkNotes.map((note) => <li>{note}</li>)}
          </ul>
        </section>
      )
    }

    {
      item.faq && (
        <section class="section content">
          <h2>자주 묻는 질문</h2>
          <div class="faq-list">
            {item.faq.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <section class="section content">
      <h2>참고와 유의사항</h2>
      <p>
        복지제도는 세전소득, 세후소득, 건강보험료, 재산, 가구원 수를 서로 다르게 활용할 수 있습니다.
        이 계산기는 신청 전 대략적인 위치를 파악하기 위한 참고용이며, 최종 자격은 관할 기관 또는 공식 신청 사이트에서 확인해야 합니다.
      </p>
      {
        item.sourceReferences && (
          <table>
            <tbody>
              {item.sourceReferences.map((source) => (
                <tr>
                  <th scope="row"><a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a></th>
                  <td>{source.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </section>

    {
      publicRelated.length > 0 && (
        <section class="section">
          <div class="section-heading">
            <div>
              <h2>공공데이터 기반 관련 복지서비스</h2>
              <p>공공데이터포털에서 가져온 중앙부처·지자체 복지서비스 중 이 계산기와 가까운 항목입니다.</p>
            </div>
            <a href="/info/welfare-public-data-source-guide/">출처 확인</a>
          </div>
          <div class="grid">
            {publicRelated.map((service) => <PublicServiceCard service={service} />)}
          </div>
        </section>
      )
    }

    <AdSenseSlot slot="check-bottom" label="하단 광고" />
  </article>

  <section class="section">
    <h2>함께 보면 좋은 정보</h2>
    <div class="post-list">
      {relatedPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="section">
    <h2>관련 체크도구</h2>
    <div class="grid">
      {(item.id === "severance-pay" ? retirementHubItems : item.id === "annual-salary-net-pay" ? salaryHubItems : moreItems).map((related) => <CheckCard item={related} />)}
    </div>
  </section>

  <script>
    const root = document.querySelector("[data-calculator]");
    const calculatorId = root?.getAttribute("data-calculator");
    const amount = root?.querySelector("[data-amount]") as HTMLInputElement | null;
    const rate = root?.querySelector("[data-rate]") as HTMLInputElement | null;
    const result = root?.querySelector("[data-result]") as HTMLOutputElement | null;
    const household = root?.querySelector("[data-household]") as HTMLSelectElement | null;
    const presetRate = root?.querySelector("[data-preset-rate]") as HTMLSelectElement | null;
    const thresholdTable = root?.querySelector("[data-threshold-table]") as HTMLDivElement | null;
    const simulatorSummary = root?.querySelector("[data-simulator-summary]") as HTMLDivElement | null;
    const region = root?.querySelector("[data-region]") as HTMLSelectElement | null;
    const earnedDeduction = root?.querySelector("[data-earned-deduction]") as HTMLSelectElement | null;
    const workIncomeType = root?.querySelector("[data-work-income-type]") as HTMLSelectElement | null;
    const medicalSupporter = root?.querySelector("[data-medical-supporter]") as HTMLSelectElement | null;
    const earnedIncome = root?.querySelector("[data-earned-income]") as HTMLInputElement | null;
    const businessIncome = root?.querySelector("[data-business-income]") as HTMLInputElement | null;
    const otherIncome = root?.querySelector("[data-other-income]") as HTMLInputElement | null;
    const expense = root?.querySelector("[data-expense]") as HTMLInputElement | null;
    const housingAsset = root?.querySelector("[data-housing-asset]") as HTMLInputElement | null;
    const generalAsset = root?.querySelector("[data-general-asset]") as HTMLInputElement | null;
    const financialAsset = root?.querySelector("[data-financial-asset]") as HTMLInputElement | null;
    const debt = root?.querySelector("[data-debt]") as HTMLInputElement | null;
    const carMode = root?.querySelector("[data-car-mode]") as HTMLSelectElement | null;
    const carAsset = root?.querySelector("[data-car-asset]") as HTMLInputElement | null;
    const pensionHousehold = root?.querySelector("[data-pension-household]") as HTMLSelectElement | null;
    const pensionRegion = root?.querySelector("[data-pension-region]") as HTMLSelectElement | null;
    const pensionEarned = root?.querySelector("[data-pension-earned]") as HTMLInputElement | null;
    const pensionBusiness = root?.querySelector("[data-pension-business]") as HTMLInputElement | null;
    const pensionPublic = root?.querySelector("[data-pension-public]") as HTMLInputElement | null;
    const pensionOther = root?.querySelector("[data-pension-other]") as HTMLInputElement | null;
    const pensionGeneralAsset = root?.querySelector("[data-pension-general-asset]") as HTMLInputElement | null;
    const pensionFinancialAsset = root?.querySelector("[data-pension-financial-asset]") as HTMLInputElement | null;
    const pensionDebt = root?.querySelector("[data-pension-debt]") as HTMLInputElement | null;
    const pensionLuxury = root?.querySelector("[data-pension-luxury]") as HTMLInputElement | null;
    const benefitIncome = root?.querySelector("[data-benefit-income]") as HTMLInputElement | null;
    const benefitMedicalIncome = root?.querySelector("[data-benefit-medical-income]") as HTMLInputElement | null;
    const benefitRegion = root?.querySelector("[data-benefit-region]") as HTMLSelectElement | null;
    const benefitHousingType = root?.querySelector("[data-benefit-housing-type]") as HTMLSelectElement | null;
    const benefitDeposit = root?.querySelector("[data-benefit-deposit]") as HTMLInputElement | null;
    const benefitMonthlyRent = root?.querySelector("[data-benefit-monthly-rent]") as HTMLInputElement | null;
    const benefitStudents = root?.querySelector("[data-benefit-students]") as HTMLInputElement | null;
    const benefitSingleParent = root?.querySelector("[data-benefit-single-parent]") as HTMLSelectElement | null;
    const freelanceMode = root?.querySelector("[data-freelance-mode]") as HTMLSelectElement | null;
    const freelanceAmount = root?.querySelector("[data-freelance-amount]") as HTMLInputElement | null;
    const freelanceMonths = root?.querySelector("[data-freelance-months]") as HTMLInputElement | null;
    const formatter = new Intl.NumberFormat("ko-KR");
    const medianIncome2026: Record<string, number> = {
      "1": 2564238,
      "2": 4199292,
      "3": 5359036,
      "4": 6494738,
      "5": 7556719,
      "6": 8555952,
    };
    const benefitRates = [["생계급여", 32], ["의료급여", 40], ["주거급여", 48], ["교육급여", 50]] as const;
    const propertyRules: Record<string, { label: string; basic: number; housingLimit: number }> = {
      seoul: { label: "서울", basic: 9900, housingLimit: 17200 },
      gyeonggi: { label: "경기", basic: 8000, housingLimit: 15100 },
      metro: { label: "광역·세종·창원", basic: 7700, housingLimit: 14600 },
      other: { label: "그 외 지역", basic: 5300, housingLimit: 11200 },
    };
    const pensionThresholds: Record<string, { label: string; amount: number }> = {
      single: { label: "단독가구", amount: 2470000 },
      couple: { label: "부부가구", amount: 3952000 },
    };
    const pensionPropertyRules: Record<string, { label: string; basic: number }> = {
      large: { label: "대도시·특례시", basic: 13500 },
      medium: { label: "중소도시·세종", basic: 8500 },
      rural: { label: "농어촌", basic: 7250 },
    };
    const housingRentStandards: Record<string, Record<string, number>> = {
      "1": { seoul: 369000, metro: 300000, city: 247000, other: 212000 },
      "2": { seoul: 414000, metro: 335000, city: 275000, other: 238000 },
      "3": { seoul: 492000, metro: 401000, city: 327000, other: 283000 },
      "4": { seoul: 571000, metro: 463000, city: 381000, other: 329000 },
      "5": { seoul: 591000, metro: 479000, city: 394000, other: 340000 },
      "6": { seoul: 699000, metro: 568000, city: 463000, other: 402000 },
    };
    const benefitRegionLabels: Record<string, string> = {
      seoul: "서울",
      metro: "경기·인천",
      city: "광역·세종·특례시",
      other: "그 외 지역",
    };
    const workTypeNotes: Record<string, string> = {
      none: "일반 근로·사업소득 기준으로 간편 공제만 반영했습니다.",
      rehab: "직업재활 참여소득은 별도 근로소득 공제 가능성이 있어 증빙과 사업 참여 확인서가 중요합니다.",
      young: "청년·대학생 수급권자는 연령, 재학, 근로 형태에 따라 공제 판단이 달라질 수 있습니다.",
      "single-parent-youth": "청소년·24세 이하 한부모는 연령과 가구 구성 증빙을 상담 전에 함께 정리하세요.",
      "protected-youth": "보호종료·가정위탁보호 종료 청년은 보호 종료 시점과 기간 확인이 필요합니다.",
      student: "초·중·고 재학 여부와 근로소득 발생 시점이 함께 확인될 수 있습니다.",
      "disabled-north": "등록장애인·북한이탈주민 여부는 증명서류와 소득 종류를 함께 확인하세요.",
      senior: "65세 이상 노인은 근로능력, 연금소득, 일자리사업 참여 여부를 함께 봐야 합니다.",
      pregnancy: "임신 중이거나 분만 후 6개월 미만이면 의료·돌봄 관련 지출 증빙도 같이 준비하세요.",
      service: "사회복무요원·상근예비역 소득은 복무 형태와 지급 명목 확인이 필요합니다.",
      intern: "공공 행정인턴 참여소득은 참여기관, 기간, 지급 명목을 상담 때 확인하세요.",
    };
    const medicalSupporterNotes: Record<string, string> = {
      unknown: "의료급여는 부양의무자 기준을 상담 때 별도로 확인해야 합니다.",
      low: "부양의무자 쟁점이 낮아 보여도 가족관계와 소득·재산 자료는 확인 대상이 될 수 있습니다.",
      check: "부양의무자 소득·재산 쟁점이 있으면 의료급여 결과가 다른 급여와 달라질 수 있습니다.",
    };

    function numberFrom(input: HTMLInputElement | HTMLSelectElement | null) {
      return Number(input?.value || 0);
    }

    function deductSequential(values: number[], deduction: number) {
      let remaining = Math.max(0, deduction);
      return values.map((value) => {
        const used = Math.min(value, remaining);
        remaining -= used;
        return Math.max(0, value - used);
      });
    }

    function render() {
      if (!result) return;

      if (calculatorId === "median-income-threshold") {
        if (!rate) return;
        const householdValue = household?.value ?? "4";
        const median = medianIncome2026[householdValue] ?? medianIncome2026["4"];
        const rateValue = Number(rate.value || 0);
        result.value = `${householdValue}인 가구 ${rateValue}% 기준: 월 ${formatter.format(Math.floor(median * (rateValue / 100)))}원`;
        result.textContent = result.value;
        if (thresholdTable) {
          thresholdTable.innerHTML = `<table><thead><tr><th scope="col">급여</th><th scope="col">비율</th><th scope="col">월 기준액</th></tr></thead><tbody>${benefitRates.map(([name, benefitRate]) => `<tr><th scope="row">${name}</th><td>${benefitRate}%</td><td>${formatter.format(Math.floor(median * (benefitRate / 100)))}원</td></tr>`).join("")}</tbody></table>`;
        }
        return;
      }

      if (calculatorId === "basic-livelihood-income-simulator") {
        const householdValue = household?.value ?? "4";
        const median = medianIncome2026[householdValue] ?? medianIncome2026["4"];
        const workDeduction = Math.round((numberFrom(earnedIncome) + numberFrom(businessIncome)) * (numberFrom(earnedDeduction) / 100));
        const incomeEvaluation = Math.max(0, numberFrom(earnedIncome) + numberFrom(businessIncome) + numberFrom(otherIncome) - workDeduction - numberFrom(expense));
        const medicalIncomeEvaluation = incomeEvaluation;
        const rule = propertyRules[region?.value ?? "other"] ?? propertyRules.other;
        const housingWithinLimit = Math.min(numberFrom(housingAsset), rule.housingLimit);
        const generalRaw = numberFrom(generalAsset) + Math.max(0, numberFrom(housingAsset) - rule.housingLimit);
        const afterDebt = deductSequential([housingWithinLimit, generalRaw, numberFrom(financialAsset)], numberFrom(debt));
        const [housingConvertedBase, generalConvertedBase, financialConvertedBase] = deductSequential(afterDebt, rule.basic);
        const propertyConversion =
          Math.round(housingConvertedBase * 10000 * 0.0104) +
          Math.round(generalConvertedBase * 10000 * 0.0417) +
          Math.round(financialConvertedBase * 10000 * 0.0626) +
          Math.round(numberFrom(carAsset) * 10000 * numberFrom(carMode));
        const medicalPropertyConversion = propertyConversion;
        const recognizedIncome = incomeEvaluation + propertyConversion;
        const medicalRecognizedIncome = medicalIncomeEvaluation + medicalPropertyConversion;
        result.value = `추정 소득인정액: 월 ${formatter.format(recognizedIncome)}원`;
        result.textContent = result.value;
        if (simulatorSummary) {
          simulatorSummary.innerHTML = `<table><tbody><tr><th scope="row">소득평가액</th><td>${formatter.format(incomeEvaluation)}원</td></tr><tr><th scope="row">소득평가액-의료 확인값</th><td>${formatter.format(medicalIncomeEvaluation)}원</td></tr><tr><th scope="row">재산의 월 소득환산액</th><td>${formatter.format(propertyConversion)}원</td></tr><tr><th scope="row">소득환산액-의료 확인값</th><td>${formatter.format(medicalPropertyConversion)}원</td></tr><tr><th scope="row">근로소득 유형 메모</th><td>${workTypeNotes[workIncomeType?.value ?? "none"]}</td></tr><tr><th scope="row">의료급여 메모</th><td>${medicalSupporterNotes[medicalSupporter?.value ?? "unknown"]}</td></tr><tr><th scope="row">적용 지역 기준</th><td>${rule.label} / 기본재산액 ${formatter.format(rule.basic)}만원 / 주거용재산 한도 ${formatter.format(rule.housingLimit)}만원</td></tr></tbody></table>`;
        }
        if (thresholdTable) {
          thresholdTable.innerHTML = `<table><thead><tr><th scope="col">급여</th><th scope="col">선정 기준</th><th scope="col">차이</th><th scope="col">판정 메모</th></tr></thead><tbody>${benefitRates.map(([name, benefitRate]) => {
            const threshold = Math.floor(median * (benefitRate / 100));
            const comparisonIncome = name === "의료급여" ? medicalRecognizedIncome : recognizedIncome;
            const gap = threshold - comparisonIncome;
            const memo = name === "의료급여" ? `${gap >= 0 ? "기준 이하 추정" : "기준 초과 추정"} · 부양의무자 별도 확인` : gap >= 0 ? "기준 이하 추정" : "기준 초과 추정";
            return `<tr><th scope="row">${name}</th><td>${formatter.format(threshold)}원</td><td>${gap >= 0 ? "+" : "-"}${formatter.format(Math.abs(gap))}원</td><td>${memo}</td></tr>`;
          }).join("")}</tbody></table>`;
        }
        return;
      }

      if (calculatorId === "basic-livelihood-benefit-estimator") {
        const householdValue = household?.value ?? "4";
        const median = medianIncome2026[householdValue] ?? medianIncome2026["4"];
        const recognizedIncome = numberFrom(benefitIncome);
        const medicalIncome = numberFrom(benefitMedicalIncome) || recognizedIncome;
        const livelihoodThreshold = Math.floor(median * 0.32);
        const medicalThreshold = Math.floor(median * 0.4);
        const housingThreshold = Math.floor(median * 0.48);
        const educationThreshold = Math.floor(median * 0.5);
        const singleParentThreshold = Math.floor(median * 0.65);
        const regionValue = benefitRegion?.value ?? "other";
        const housingType = benefitHousingType?.value ?? "rent";
        const standardRent = housingRentStandards[householdValue]?.[regionValue] ?? housingRentStandards["4"].other;
        const depositMonthly = Math.floor(numberFrom(benefitDeposit) * 10000 * 0.04 / 12);
        const actualRent = housingType === "own" ? 0 : housingType === "jeonse" ? depositMonthly : depositMonthly + numberFrom(benefitMonthlyRent);
        const housingDeduction = recognizedIncome > livelihoodThreshold ? Math.floor((recognizedIncome - livelihoodThreshold) * 0.3) : 0;
        let housingBenefit = recognizedIncome <= housingThreshold && housingType !== "own" ? Math.max(0, Math.min(actualRent, standardRent) - housingDeduction) : 0;
        if (housingBenefit > 0 && housingBenefit < 10000) housingBenefit = 10000;
        const livelihoodBenefit = recognizedIncome <= livelihoodThreshold ? Math.max(0, livelihoodThreshold - recognizedIncome) : 0;
        const educationEligible = recognizedIncome <= educationThreshold && numberFrom(benefitStudents) > 0;
        const medicalEligible = medicalIncome <= medicalThreshold;
        const singleParentEligible = benefitSingleParent?.value === "yes" && recognizedIncome <= singleParentThreshold;
        const eligibleCount = [livelihoodBenefit > 0, medicalEligible, housingBenefit > 0 || (recognizedIncome <= housingThreshold && housingType === "own"), educationEligible, singleParentEligible].filter(Boolean).length;
        result.value = `급여별 가능성: ${eligibleCount}개 항목이 기준 이하 또는 검토권입니다`;
        result.textContent = result.value;
        if (simulatorSummary) {
          simulatorSummary.innerHTML = `<table><tbody><tr><th scope="row">입력 소득인정액</th><td>${formatter.format(recognizedIncome)}원</td></tr><tr><th scope="row">주거급여 기준임대료</th><td>${benefitRegionLabels[regionValue]} ${householdValue}인 기준 ${formatter.format(standardRent)}원</td></tr><tr><th scope="row">실제임차료 간편 환산</th><td>${formatter.format(actualRent)}원</td></tr><tr><th scope="row">주거급여 자기부담분</th><td>${formatter.format(housingDeduction)}원</td></tr></tbody></table>`;
        }
        if (thresholdTable) {
          const rows = [
            ["생계급여", livelihoodThreshold, livelihoodBenefit > 0 ? `${formatter.format(livelihoodBenefit)}원 예상` : "기준 초과", "기준선과 차액 확인"],
            ["의료급여", medicalThreshold, medicalEligible ? "기준 이하" : "기준 초과", "부양의무자 등 별도 기준 확인"],
            ["주거급여", housingThreshold, housingType === "own" ? (recognizedIncome <= housingThreshold ? "자가가구 수선유지급여 검토" : "기준 초과") : housingBenefit > 0 ? `${formatter.format(housingBenefit)}원 간편 추정` : "기준 초과 또는 차감 후 0원", "임대차계약서와 실제임차료 확인"],
            ["교육급여", educationThreshold, educationEligible ? "학생 가구 기준 이하" : numberFrom(benefitStudents) > 0 ? "기준 초과" : "학생 수 미입력", "초·중·고 학생 여부 확인"],
            ["한부모가족 지원", singleParentThreshold, singleParentEligible ? "참고 기준 이하" : benefitSingleParent?.value === "yes" ? "참고 기준 초과" : "해당 없음", "연령·양육 조건 별도 확인"],
          ];
          thresholdTable.innerHTML = `<table><thead><tr><th scope="col">항목</th><th scope="col">기준선</th><th scope="col">결과</th><th scope="col">다음 확인</th></tr></thead><tbody>${rows.map(([name, threshold, status, memo]) => `<tr><th scope="row">${name}</th><td>${formatter.format(Number(threshold))}원</td><td>${status}</td><td>${memo}</td></tr>`).join("")}</tbody></table>`;
        }
        return;
      }

      if (calculatorId === "basic-pension-income-simulator") {
        const threshold = pensionThresholds[pensionHousehold?.value ?? "single"] ?? pensionThresholds.single;
        const rule = pensionPropertyRules[pensionRegion?.value ?? "large"] ?? pensionPropertyRules.large;
        const earnedEvaluation = Math.max(0, Math.round((numberFrom(pensionEarned) - 1160000) * 0.7));
        const incomeEvaluation = earnedEvaluation + numberFrom(pensionBusiness) + numberFrom(pensionPublic) + numberFrom(pensionOther);
        const propertyBase = Math.max(0, Math.max(0, numberFrom(pensionGeneralAsset) - rule.basic) + Math.max(0, numberFrom(pensionFinancialAsset) - 2000) - numberFrom(pensionDebt));
        const propertyConversion = Math.round(propertyBase * 10000 * 0.04 / 12);
        const recognizedIncome = incomeEvaluation + propertyConversion + numberFrom(pensionLuxury) * 10000;
        const gap = threshold.amount - recognizedIncome;
        result.value = `추정 소득인정액: 월 ${formatter.format(recognizedIncome)}원`;
        result.textContent = result.value;
        if (simulatorSummary) {
          simulatorSummary.innerHTML = `<table><tbody><tr><th scope="row">소득평가액</th><td>${formatter.format(incomeEvaluation)}원</td></tr><tr><th scope="row">재산의 월 소득환산액</th><td>${formatter.format(propertyConversion)}원</td></tr><tr><th scope="row">적용 공제</th><td>${rule.label} 기본재산액 ${formatter.format(rule.basic)}만원 / 금융재산 2,000만원 공제</td></tr></tbody></table>`;
        }
        if (thresholdTable) {
          thresholdTable.innerHTML = `<table><thead><tr><th scope="col">구분</th><th scope="col">2026 선정기준액</th><th scope="col">차이</th><th scope="col">메모</th></tr></thead><tbody><tr><th scope="row">${threshold.label}</th><td>${formatter.format(threshold.amount)}원</td><td>${gap >= 0 ? "+" : "-"}${formatter.format(Math.abs(gap))}원</td><td>${gap >= 0 ? "기준 이하 추정" : "기준 초과 추정"}</td></tr></tbody></table>`;
        }
        return;
      }

      if (calculatorId === "freelancer-tax-3-3") {
        const inputAmount = numberFrom(freelanceAmount);
        const months = Math.max(1, numberFrom(freelanceMonths) || 1);
        const mode = freelanceMode?.value ?? "gross";
        const gross = mode === "net" ? Math.round(inputAmount / 0.967) : inputAmount;
        const incomeTax = Math.floor(gross * 0.03);
        const localTax = Math.floor(gross * 0.003);
        const withholding = incomeTax + localTax;
        const net = gross - withholding;
        const monthlyGross = Math.round(gross / months);
        const monthlyNet = Math.round(net / months);
        result.value =
          mode === "net"
            ? `역산 세전 지급액: ${formatter.format(gross)}원`
            : `예상 실수령액: ${formatter.format(net)}원`;
        result.textContent = result.value;
        if (simulatorSummary) {
          simulatorSummary.innerHTML = `<table><tbody><tr><th scope="row">세전 지급액</th><td>${formatter.format(gross)}원</td></tr><tr><th scope="row">소득세 3%</th><td>${formatter.format(incomeTax)}원</td></tr><tr><th scope="row">지방소득세 0.3%</th><td>${formatter.format(localTax)}원</td></tr><tr><th scope="row">총 원천징수액</th><td>${formatter.format(withholding)}원</td></tr><tr><th scope="row">실제 입금액</th><td>${formatter.format(net)}원</td></tr><tr><th scope="row">${months}개월 월평균</th><td>세전 ${formatter.format(monthlyGross)}원 / 입금 ${formatter.format(monthlyNet)}원</td></tr></tbody></table>`;
        }
        return;
      }

      if (!amount || !rate) return;
      const calculated = Math.round(Number(amount.value || 0) * (Number(rate.value || 0) / 100));
      result.value = `예상 금액: ${formatter.format(calculated)}원`;
      result.textContent = result.value;
    }

    amount?.addEventListener("input", render);
    rate?.addEventListener("input", render);
    household?.addEventListener("change", render);
    presetRate?.addEventListener("change", () => {
      if (!rate || !presetRate) return;
      rate.value = presetRate.value;
      render();
    });
    [
      region, earnedDeduction, workIncomeType, medicalSupporter, earnedIncome, businessIncome, otherIncome, expense, housingAsset, generalAsset,
      financialAsset, debt, carMode, carAsset, pensionHousehold, pensionRegion, pensionEarned, pensionBusiness,
      pensionPublic, pensionOther, pensionGeneralAsset, pensionFinancialAsset, pensionDebt, pensionLuxury,
      benefitIncome, benefitMedicalIncome, benefitRegion, benefitHousingType, benefitDeposit, benefitMonthlyRent,
      benefitStudents, benefitSingleParent, freelanceMode, freelanceAmount, freelanceMonths,
    ].forEach((input) => input?.addEventListener(input instanceof HTMLInputElement ? "input" : "change", render));
    render();
  </script>
</BaseLayout>

