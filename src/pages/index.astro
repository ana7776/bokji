---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CheckCard from "@/components/CheckCard.astro";
import PostCard from "@/components/PostCard.astro";
import { checkItems, uniqueCategories } from "@/lib/items";

const posts = (await getCollection("info")).sort(
  (a, b) => Date.parse(b.data.updatedAt) - Date.parse(a.data.updatedAt),
);
const categories = uniqueCategories();
const featuredItems = [
  "monthly-salary-net-pay",
  "loan-interest",
  "jeonse-loan-interest",
  "electricity-bill",
  "global-income-tax-simple",
  "unemployment-benefit",
]
  .map((id) => checkItems.find((item) => item.id === id))
  .filter(Boolean);

const guideLinks = [
  { label: "소득·급여", href: "/check/income/", note: "월급, 연봉, 4대보험, 퇴직금" },
  { label: "주거비", href: "/check/housing/", note: "전세대출, 중개수수료, 면적" },
  { label: "생활비", href: "/check/living-cost/", note: "대출이자, 전기요금, 통신비" },
  { label: "세금·재산", href: "/check/tax/", note: "부가세, 종합소득세, 금융재산" },
];

const quickSituations = [
  ["퇴사 전", "퇴직금·실업급여·연차수당을 함께 확인"],
  ["이사 전", "전세대출 이자와 중개수수료 부담 점검"],
  ["신청 전", "소득·재산·부채 기준을 따로 계산"],
  ["고정비 절감", "전기요금·통신비·대출이자를 월 단위로 정리"],
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">2026 welfare check desk</p>
      <h1>복지 신청 전에 소득, 재산, 생활비 기준을 먼저 정리하세요</h1>
      <p class="lead">
        복지체크는 흩어진 계산 기준을 신청 전 점검 순서로 묶어 보여줍니다. 월급 실수령액부터 주거비, 부채, 공과금까지 한 번에 확인하세요.
      </p>
      <form class="search-panel" action="/check/" method="get">
        <label for="q">필요한 계산기나 상황 검색</label>
        <div>
          <input id="q" name="q" type="search" placeholder="예: 월급 실수령액, 전세대출, 실업급여, 전기요금" />
          <button type="submit">검색</button>
        </div>
      </form>
      <div class="hero-actions">
        <a class="primary-link" href="/check/">전체 체크도구</a>
        <a class="secondary-link" href="/info/">신청 전 가이드</a>
      </div>
    </div>

    <aside class="finder-card" aria-label="빠른 복지 기준 점검">
      <div class="finder-header">
        <span>빠른 기준 점검</span>
        <strong>{checkItems.length}개 도구</strong>
      </div>
      <div class="finder-steps">
        <a href="/check/income/earned-income/monthly-salary-net-pay/">
          <span>1</span>
          <strong>월 소득 확인</strong>
          <small>실수령액과 공제액</small>
        </a>
        <a href="/check/asset/financial-asset/deposit-interest/">
          <span>2</span>
          <strong>재산 기준 점검</strong>
          <small>예금·적금 이자와 금융재산</small>
        </a>
        <a href="/check/living-cost/debt/loan-interest/">
          <span>3</span>
          <strong>부채·생활비 정리</strong>
          <small>대출이자와 고정지출</small>
        </a>
      </div>
    </aside>
  </section>

  <section class="quick-band" aria-label="상황별 빠른 안내">
    {quickSituations.map(([title, text]) => (
      <article>
        <strong>{title}</strong>
        <span>{text}</span>
      </article>
    ))}
  </section>

  <section class="section section-head">
    <div>
      <p class="section-kicker">맞춤 탐색</p>
      <h2>필요한 기준부터 바로 들어가기</h2>
    </div>
    <a href="/check/">모든 도구 보기</a>
  </section>
  <div class="guide-grid">
    {guideLinks.map((link) => (
      <a href={link.href}>
        <strong>{link.label}</strong>
        <span>{link.note}</span>
      </a>
    ))}
  </div>

  <section class="section section-head">
    <div>
      <p class="section-kicker">카테고리</p>
      <h2>복지 기준을 계산 항목별로 보기</h2>
    </div>
  </section>
  <div class="category-grid">
    {categories.map((category) => (
      <a href={`/check/${category.category}/`}>
        <strong>{category.label}</strong>
        <span>{category.count}개 체크도구</span>
      </a>
    ))}
  </div>

  <section class="section section-head">
    <div>
      <p class="section-kicker">추천 도구</p>
      <h2>신청 전 자주 확인하는 계산기</h2>
    </div>
  </section>
  <div class="grid">
    {featuredItems.map((item) => item && <CheckCard item={item} />)}
  </div>

  <section class="section info-layout">
    <div>
      <p class="section-kicker">정보성 칼럼</p>
      <h2>함께 보면 좋은 신청 전 가이드</h2>
      <p>
        계산 결과만으로 판단하기 어려운 소득 산정, 금융재산, 부채, 주거비 기준을 글로 정리했습니다.
      </p>
    </div>
    <div class="post-list">
      {posts.slice(0, 8).map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.7fr);
    gap: 2rem;
    align-items: stretch;
    padding: 2.25rem 0 1rem;
  }

  .hero-copy {
    display: grid;
    align-content: center;
    gap: 1rem;
    min-height: 430px;
    padding: 2.5rem;
    border: 1px solid #d7e1e8;
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(244, 249, 251, 0.9)),
      #ffffff;
    box-shadow: 0 24px 60px rgba(42, 60, 82, 0.08);
  }

  .eyebrow,
  .section-kicker {
    margin: 0;
    color: #c0572a;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .search-panel {
    display: grid;
    gap: 0.55rem;
    max-width: 760px;
    margin-top: 0.5rem;
  }

  .search-panel label {
    color: #25334b;
    font-weight: 900;
  }

  .search-panel div {
    display: flex;
    gap: 0.55rem;
  }

  .search-panel input {
    flex: 1;
    min-width: 0;
    border: 2px solid #0f5f74;
    border-radius: 8px;
    background: #ffffff;
    padding: 1rem 1.05rem;
    font: inherit;
  }

  .search-panel button,
  .primary-link {
    border: 0;
    border-radius: 8px;
    background: #0f5f74;
    color: #ffffff;
    padding: 0.95rem 1.25rem;
    font: inherit;
    font-weight: 900;
    text-decoration: none;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .secondary-link {
    border: 1px solid #cbd8e3;
    border-radius: 8px;
    background: #ffffff;
    color: #24324a;
    padding: 0.95rem 1.25rem;
    font-weight: 900;
    text-decoration: none;
  }

  .finder-card {
    display: grid;
    gap: 1rem;
    align-content: start;
    border-radius: 8px;
    background: #172033;
    color: #ffffff;
    padding: 1.35rem;
    box-shadow: 0 24px 60px rgba(23, 32, 51, 0.16);
  }

  .finder-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #c8d4e4;
    font-size: 0.9rem;
  }

  .finder-header strong {
    color: #ffd36a;
  }

  .finder-steps {
    display: grid;
    gap: 0.8rem;
  }

  .finder-steps a {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.15rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .finder-steps span {
    grid-row: span 2;
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border-radius: 8px;
    background: #ffd36a;
    color: #172033;
    font-weight: 900;
  }

  .finder-steps small {
    color: #c8d4e4;
  }

  .quick-band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1.25rem;
  }

  .quick-band article {
    display: grid;
    gap: 0.35rem;
    border: 1px solid #dce4ec;
    border-radius: 8px;
    background: #ffffff;
    padding: 1rem;
  }

  .quick-band strong {
    color: #0f5f74;
  }

  .quick-band span {
    color: #5b687a;
    font-size: 0.92rem;
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-head h2 {
    margin-bottom: 0;
  }

  .section-head a {
    font-weight: 900;
    text-decoration: none;
  }

  .guide-grid,
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.8rem;
  }

  .guide-grid a,
  .category-grid a {
    display: grid;
    gap: 0.4rem;
    border: 1px solid #d8e2eb;
    border-radius: 8px;
    background: #ffffff;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .guide-grid strong,
  .category-grid strong {
    font-size: 1.03rem;
  }

  .guide-grid span,
  .category-grid span {
    color: #607080;
    font-size: 0.9rem;
  }

  .info-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.45fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .info-layout > div:first-child {
    position: sticky;
    top: 6rem;
  }

  .info-layout p {
    color: #5b687a;
  }

  .post-list {
    display: grid;
    border-top: 1px solid #dfe6ef;
  }

  @media (max-width: 860px) {
    .hero,
    .info-layout {
      grid-template-columns: 1fr;
    }

    .hero-copy {
      min-height: auto;
      padding: 1.35rem;
    }

    .quick-band {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .info-layout > div:first-child {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .search-panel div,
    .hero-actions,
    .section-head {
      align-items: stretch;
      flex-direction: column;
    }

    .quick-band {
      grid-template-columns: 1fr;
    }
  }
</style>
