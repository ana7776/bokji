---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CheckCard from "@/components/CheckCard.astro";
import PostCard from "@/components/PostCard.astro";
import { categoryPath, checkItems, uniqueCategories } from "@/lib/items";
import { reportSeries } from "@/lib/reportSeries";

const posts = (await getCollection("info")).sort(
  (a, b) => Date.parse(b.data.updatedAt) - Date.parse(a.data.updatedAt),
);

const categories = uniqueCategories();
const featuredItems = [
  "monthly-salary-net-pay",
  "loan-interest",
  "jeonse-loan-interest",
  "electricity-bill",
  "global-income-tax-simple",
  "unemployment-benefit",
]
  .map((id) => checkItems.find((item) => item.id === id))
  .filter(Boolean);

const quickLinks = [
  { label: "전체 체크도구", href: "/check/", note: `${checkItems.length}개 계산기` },
  { label: "복지 가이드", href: "/info/", note: `${posts.length}개 정보 글` },
  { label: "공식 출처", href: "/sources/", note: "정부·공공기관 기준" },
  { label: "문의·정정", href: "/contact/", note: "오류 제보와 기준 확인" },
];

const trustNotes = [
  "보건복지부, 복지로, 국민연금공단, 고용노동부 등 공식 자료를 우선 확인합니다.",
  "소득, 재산, 부채, 주거비처럼 심사에 영향을 주는 입력값을 분리해 설명합니다.",
  "계산 결과는 신청 전 참고용이며 최종 판단은 담당 기관의 최신 기준을 따릅니다.",
  "복지 기준이 바뀌면 기준연도, 금액, 관련 글과 계산기를 함께 점검합니다.",
];

const reports = reportSeries
  .map((series) => ({
    ...series,
    href: `/info/${series.slugs[0]}/`,
    count: series.slugs.length,
  }))
  .slice(0, 4);
---

<BaseLayout>
  <section class="home-shell" aria-label="복지CHECK 메인">
    <aside class="left-rail" aria-label="복지 기준 탐색">
      <a class="brand-panel" href="/check/">
        <span>복지CHECK</span>
        <strong>나에게 맞는 복지 기준을 빠르게 확인하세요</strong>
      </a>

      <nav class="rail-nav" aria-label="카테고리 바로가기">
        <h2>카테고리</h2>
        {categories.map((category) => (
          <a href={categoryPath(category.category)}>
            <span>{category.label}</span>
            <small>{category.count}개</small>
          </a>
        ))}
      </nav>
    </aside>

    <main class="center-column">
      <section class="hero" aria-label="복지CHECK 소개">
        <div class="hero-copy">
          <p class="eyebrow">신청 전에 먼저 보는 복지 기준표</p>
          <h1><span>복지CHECK</span>로 소득, 재산, 생활비 기준을 한 번에 정리하세요</h1>
          <p class="lead">
            복잡한 복지 정보와 계산 기준을 신청 전 점검 순서로 묶었습니다. 필요한 도구와 가이드를 바로 찾아보세요.
          </p>
          <form class="search-panel" action="/check/" method="get">
            <label class="sr-only" for="q">복지서비스 검색</label>
            <input id="q" name="q" type="search" placeholder="예: 월급 실수령액, 전세대출, 기초생활, 전기요금" />
            <button type="submit" aria-label="검색">
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" />
              </svg>
            </button>
          </form>
        </div>
        <img
          src="/images/bokjicheck-hero.webp"
          width="760"
          height="470"
          alt="복지CHECK 서비스 화면과 복지 아이콘 일러스트"
          loading="eager"
        />
      </section>

      <section class="quick-grid" aria-label="주요 바로가기">
        {quickLinks.map((link) => (
          <a href={link.href}>
            <strong>{link.label}</strong>
            <span>{link.note}</span>
          </a>
        ))}
      </section>

      <section class="report-panel" aria-labelledby="report-title">
        <div class="section-heading">
          <p>심층 리포트</p>
          <h2 id="report-title">검색으로 들어온 뒤 이어서 읽기 좋은 주제 묶음</h2>
        </div>
        <div class="report-grid">
          {reports.map((report) => (
            <a href={report.href}>
              <strong>{report.title}</strong>
              <span>{report.description}</span>
              <small>{report.count}개 글로 이어보기</small>
            </a>
          ))}
        </div>
      </section>

      <section class="main-list" aria-labelledby="guide-title">
        <div class="section-heading">
          <p>복지 정보</p>
          <h2 id="guide-title">신청 전에 확인할 최신 복지 가이드</h2>
        </div>
        <div class="post-list">
          {posts.slice(0, 20).map((post) => <PostCard post={post} />)}
        </div>
      </section>
    </main>

    <aside class="right-rail" aria-label="추천 계산기와 운영 기준">
      <section class="side-panel">
        <div class="side-heading">
          <p>추천 도구</p>
          <h2>자주 확인하는 계산기</h2>
        </div>
        <div class="tool-list">
          {featuredItems.map((item) => item && <CheckCard item={item} />)}
        </div>
      </section>

      <section class="side-panel">
        <div class="side-heading">
          <p>검수 기준</p>
          <h2>정보 확인 원칙</h2>
        </div>
        <ul class="trust-list">
          {trustNotes.map((note) => <li>{note}</li>)}
        </ul>
      </section>
    </aside>
  </section>
</BaseLayout>

<style>
  .home-shell {
    display: grid;
    grid-template-columns: minmax(190px, 230px) minmax(0, 1fr) minmax(270px, 330px);
    gap: 1.25rem;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.25rem;
  }

  .left-rail,
  .right-rail {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .left-rail,
  .right-rail {
    position: sticky;
    top: 5.4rem;
    max-height: calc(100vh - 6rem);
    overflow: auto;
  }

  .brand-panel,
  .rail-nav,
  .side-panel {
    border: 1px solid #dce6f2;
    border-radius: 8px;
    background: #ffffff;
  }

  .brand-panel {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
    color: #111827;
    text-decoration: none;
  }

  .brand-panel span,
  .eyebrow,
  .section-heading p,
  .side-heading p {
    color: #1154c8;
    font-weight: 900;
  }

  .brand-panel strong {
    color: #172033;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .rail-nav {
    display: grid;
    padding: 0.85rem;
  }

  .rail-nav h2,
  .side-heading h2,
  .section-heading h2 {
    margin: 0;
    color: #111b31;
  }

  .rail-nav h2 {
    padding: 0 0.15rem 0.65rem;
    font-size: 1rem;
  }

  .rail-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid #edf2f7;
    padding: 0.78rem 0.15rem;
    color: #172033;
    font-weight: 800;
    text-decoration: none;
  }

  .rail-nav small {
    color: #64748b;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .center-column {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
    align-items: center;
    gap: 1.25rem;
    overflow: hidden;
    border: 1px solid #d6e4f7;
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(244, 248, 255, 0.96), rgba(232, 244, 255, 0.98)),
      #eef6ff;
    padding: 1.45rem;
  }

  .hero-copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .eyebrow {
    margin: 0;
    font-size: 0.94rem;
  }

  h1 {
    color: #15213a;
    font-size: clamp(2rem, 3.4vw, 3.35rem);
    line-height: 1.18;
  }

  h1 span {
    color: #0f56d6;
  }

  .lead {
    margin: 0;
    color: #334155;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .hero img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .search-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.8rem;
    width: min(100%, 560px);
    min-height: 3.8rem;
    overflow: hidden;
    border: 1px solid #9fb4d0;
    border-radius: 8px;
    background: #ffffff;
  }

  .search-panel input {
    min-width: 0;
    border: 0;
    padding: 0 1.1rem;
    color: #172033;
    font: inherit;
    outline: 0;
  }

  .search-panel button {
    display: grid;
    place-items: center;
    border: 0;
    background: #0d55d8;
    color: #ffffff;
    cursor: pointer;
  }

  .search-panel svg {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.2;
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .quick-grid a {
    display: grid;
    gap: 0.3rem;
    min-height: 92px;
    border: 1px solid #dce6f2;
    border-radius: 8px;
    background: #ffffff;
    padding: 0.95rem;
    color: #172033;
    text-decoration: none;
  }

  .quick-grid strong {
    font-size: 1rem;
  }

  .quick-grid span {
    color: #64748b;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .main-list {
    border: 1px solid #dce6f2;
    border-radius: 8px;
    background: #ffffff;
    padding: 1.15rem;
  }

  .report-panel {
    border: 1px solid #dce6f2;
    border-radius: 8px;
    background: #ffffff;
    padding: 1.15rem;
  }

  .report-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .report-grid a {
    display: grid;
    gap: 0.55rem;
    min-height: 168px;
    border: 1px solid #d8e5f7;
    border-radius: 8px;
    background: #f8fbff;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .report-grid strong {
    color: #172033;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .report-grid span {
    color: #536174;
    line-height: 1.65;
  }

  .report-grid small {
    align-self: end;
    color: #1d4ed8;
    font-weight: 900;
  }

  .section-heading,
  .side-heading {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 0.85rem;
  }

  .section-heading p,
  .side-heading p {
    margin: 0;
    font-size: 0.86rem;
  }

  .section-heading h2 {
    font-size: 1.35rem;
  }

  .side-heading h2 {
    font-size: 1.05rem;
  }

  .post-list {
    display: grid;
    border-top: 1px solid #dfe6ef;
  }

  .side-panel {
    padding: 1rem;
  }

  .tool-list {
    display: grid;
    gap: 0.85rem;
  }

  .tool-list :global(.check-card a) {
    min-height: 150px;
  }

  .trust-list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.1rem;
    color: #475569;
    line-height: 1.65;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .home-shell {
      grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
    }

    .right-rail {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  @media (max-width: 860px) {
    .home-shell,
    .hero,
    .right-rail {
      grid-template-columns: 1fr;
    }

    .left-rail {
      position: static;
      max-height: none;
      overflow: visible;
    }

    .rail-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 0.7rem;
    }

    .rail-nav h2 {
      grid-column: 1 / -1;
    }

    .quick-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .report-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .home-shell {
      padding: 0.85rem;
    }

    .hero,
    .main-list,
    .side-panel {
      padding: 1rem;
    }

    .quick-grid,
    .rail-nav {
      grid-template-columns: 1fr;
    }

    .search-panel {
      grid-template-columns: minmax(0, 1fr) 3.4rem;
    }
  }
</style>
