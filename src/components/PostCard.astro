---
import type { InfoPost } from "@/lib/info";
import { postPath } from "@/lib/info";

interface Props {
  post: InfoPost;
}

const { post } = Astro.props;
---

<article class="post-card">
  <a href={postPath(post)}>
    <span>{post.data.category}</span>
    <strong>{post.data.title}</strong>
    <p>{post.data.description}</p>
    <time datetime={post.data.updatedAt}>업데이트 {post.data.updatedAt}</time>
  </a>
</article>

<style>
  .post-card {
    border-bottom: 1px solid #dfe6ef;
  }

  .post-card a {
    display: grid;
    gap: 0.45rem;
    padding: 1rem 0;
    color: inherit;
    text-decoration: none;
  }

  .post-card span {
    color: #7b4d17;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .post-card strong {
    font-size: 1.06rem;
  }

  .post-card p {
    margin: 0;
    color: #536174;
    line-height: 1.65;
  }

  .post-card time {
    color: #7a8697;
    font-size: 0.82rem;
  }
</style>
