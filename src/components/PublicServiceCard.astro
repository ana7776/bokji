---
import type { PublicWelfareService } from "@/lib/publicServices";

interface Props {
  service: PublicWelfareService;
}

const { service } = Astro.props;
const sourceLabel = service.source === "central" ? "중앙부처" : "지자체";
const areaLabel = service.source === "local" ? [service.region, service.city].filter(Boolean).join(" ") : service.provider;
---

<article class="public-service-card">
  <a href={service.url} target="_blank" rel="nofollow noopener">
    <span>{sourceLabel}{areaLabel ? ` / ${areaLabel}` : ""}</span>
    <h3>{service.title}</h3>
    <p>{service.summary}</p>
    <small>
      {[service.delivery, service.applyMethod, service.contact ? `문의 ${service.contact}` : ""].filter(Boolean).join(" · ")}
    </small>
  </a>
</article>

<style>
  .public-service-card {
    border: 1px solid #d9e5f2;
    border-radius: 8px;
    background: #ffffff;
  }

  .public-service-card a {
    display: grid;
    gap: 0.45rem;
    min-height: 180px;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .public-service-card span {
    color: #1d4ed8;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .public-service-card h3 {
    margin: 0;
    color: #172033;
    font-size: 1.02rem;
    line-height: 1.38;
  }

  .public-service-card p {
    margin: 0;
    color: #526071;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .public-service-card small {
    color: #697789;
    font-size: 0.82rem;
    line-height: 1.45;
  }
</style>
