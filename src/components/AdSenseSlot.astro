---
import { siteConfig } from "@/config/site";

interface Props {
  slot: string;
  label?: string;
}

const { slot, label = "광고" } = Astro.props;
const hasPublisherId = /^ca-pub-\d+$/.test(siteConfig.adsenseClientId) && !/^ca-pub-0+$/.test(siteConfig.adsenseClientId);
const hasNumericSlotId = /^\d+$/.test(slot);
const shouldRenderAdUnit = hasPublisherId && hasNumericSlotId;
const shouldRenderPlaceholder = hasPublisherId && !hasNumericSlotId;
---

{
  shouldRenderAdUnit ? (
    <aside class="ad-slot" aria-label={label} data-ad-slot={slot}>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={siteConfig.adsenseClientId}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  ) : shouldRenderPlaceholder ? (
    <aside class="ad-slot ad-slot-placeholder" aria-label={label} data-ad-slot={slot}>
      <span>{label}</span>
      <small>AdSense 광고 단위 ID를 발급받으면 숫자 슬롯 ID로 교체하세요.</small>
    </aside>
  ) : null
}

<style>
  .ad-slot {
    display: grid;
    min-height: 96px;
    place-items: center;
    border: 1px dashed #a7b3c7;
    border-radius: 8px;
    background: #f7f9fc;
    color: #4a5870;
    text-align: center;
  }

  .ad-slot span {
    font-size: 0.86rem;
    font-weight: 700;
  }

  .ad-slot small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.78rem;
  }
</style>
