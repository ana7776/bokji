---
interface Props {
  slot: string;
  label?: string;
}

const { slot, label = "광고" } = Astro.props;
---

<aside class="ad-slot" aria-label={label} data-ad-slot={slot}>
  <span>AdSense Slot</span>
  <small>승인 후 광고 코드 삽입 위치</small>
</aside>

<style>
  .ad-slot {
    display: grid;
    min-height: 96px;
    place-items: center;
    border: 1px dashed #a7b3c7;
    border-radius: 8px;
    background: #f7f9fc;
    color: #4a5870;
    text-align: center;
  }

  .ad-slot span {
    font-size: 0.86rem;
    font-weight: 700;
  }

  .ad-slot small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.78rem;
  }
</style>
