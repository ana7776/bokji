---
import { siteConfig } from "@/config/site";

interface Props {
  slot: string;
  label?: string;
}

const { slot, label = "광고" } = Astro.props;
const hasPublisherId = /^ca-pub-\d+$/.test(siteConfig.adsenseClientId) && !/^ca-pub-0+$/.test(siteConfig.adsenseClientId);
const hasNumericSlotId = /^\d+$/.test(slot);
const shouldRenderAdUnit = hasPublisherId && hasNumericSlotId;
---

{
  shouldRenderAdUnit && (
    <aside class="ad-slot" aria-label={label} data-ad-slot={slot}>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={siteConfig.adsenseClientId}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  )
}

<style>
  .ad-slot {
    display: grid;
    min-height: 96px;
    place-items: center;
  }
</style>
