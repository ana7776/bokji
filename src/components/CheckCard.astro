---
import type { CheckItem } from "@/lib/items";
import { itemPath } from "@/lib/items";

interface Props {
  item: CheckItem;
}

const { item } = Astro.props;
---

<article class="check-card">
  <a href={itemPath(item)}>
    <span>{item.categoryLabel} · {item.subCategoryLabel}</span>
    <strong>{item.title}</strong>
    <p>{item.description}</p>
  </a>
</article>

<style>
  .check-card {
    border: 1px solid #d9e1ec;
    border-radius: 8px;
    background: #ffffff;
  }

  .check-card a {
    display: grid;
    gap: 0.55rem;
    min-height: 180px;
    padding: 1.1rem;
    color: inherit;
    text-decoration: none;
  }

  .check-card span {
    color: #2f6f63;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .check-card strong {
    font-size: 1.08rem;
    line-height: 1.35;
  }

  .check-card p {
    margin: 0;
    color: #526071;
    font-size: 0.92rem;
    line-height: 1.65;
  }
</style>
