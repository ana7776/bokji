<section class="section bkc" id="c-el">
  <h2>주택용 전기요금 계산 (저압)</h2>
  <p class="bkc-basis">누진 3단계 · 기후환경요금·연료비조정액·부가세 10%·전력기금 2.7% 포함 추정</p>
  <div class="bkc-grid">
    <label>월 사용량(kWh)<input id="el-kwh" type="number" inputmode="numeric" min="0" step="1" value="350" /></label>
    <label>사용 시기
      <select id="el-season"><option value="normal" selected>기타 계절 (1~6월, 9~12월)</option><option value="summer">하계 (7~8월, 누진 완화)</option></select>
    </label>
  </div>
  <output id="el-result" aria-live="polite">입력값을 기준으로 청구액을 표시합니다.</output>
  <div class="bkc-table" id="el-table"></div>
  <p class="bkc-note">기타 계절은 200·400kWh, 하계는 300·450kWh에서 누진 구간이 바뀝니다. 아파트 고압 일괄계약 세대와 복지할인(기초수급·장애인 정액할인, 다자녀 30% 등) 적용 세대는 실제 청구액이 다릅니다. 복지할인은 한전(123)에 신청해야 적용됩니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { formatKRW } from "@/lib/calc2026";
  const root = document.getElementById("c-el");
  if (root) {
    const kwhEl = document.getElementById("el-kwh") as HTMLInputElement | null;
    const season = document.getElementById("el-season") as HTMLSelectElement | null;
    const result = document.getElementById("el-result");
    const table = document.getElementById("el-table");
    const BASE = [910, 1600, 7300];
    const UNIT = [120.0, 214.6, 307.3];
    const CLIMATE = 9, FUEL = 5, FUND = 0.027;
    const render = () => {
      if (!result || !table) return;
      const kwh = Number(kwhEl?.value || 0);
      if (kwh <= 0) { result.textContent = "월 사용량을 입력해 주세요."; table.innerHTML = ""; return; }
      const summer = season?.value === "summer";
      const t1 = summer ? 300 : 200, t2 = summer ? 450 : 400;
      const tier = kwh <= t1 ? 0 : kwh <= t2 ? 1 : 2;
      const energy = Math.min(kwh, t1) * UNIT[0]
        + (kwh > t1 ? (Math.min(kwh, t2) - t1) * UNIT[1] : 0)
        + (kwh > t2 ? (kwh - t2) * UNIT[2] : 0);
      const supply = BASE[tier] + energy + kwh * CLIMATE + kwh * FUEL;
      const vat = Math.round(supply * 0.1);
      const fund = Math.floor(supply * FUND / 10) * 10;
      const total = Math.floor((supply + vat + fund) / 10) * 10;
      result.textContent = `예상 청구액: ${formatKRW(total)} (${tier + 1}단계 구간)`;
      table.innerHTML = `<table><tbody>
        <tr><th scope="row">기본요금</th><td>${formatKRW(BASE[tier])}</td></tr>
        <tr><th scope="row">전력량요금</th><td>${formatKRW(energy)}</td></tr>
        <tr><th scope="row">기후환경요금 + 연료비조정</th><td>${formatKRW(kwh * (CLIMATE + FUEL))}</td></tr>
        <tr><th scope="row">부가세 + 전력기금</th><td>${formatKRW(vat + fund)}</td></tr>
      </tbody></table>`;
    };
    kwhEl?.addEventListener("input", render);
    season?.addEventListener("change", render);
    render();
  }
</script>
