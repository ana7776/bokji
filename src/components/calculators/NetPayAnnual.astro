<section class="section bkc" id="c-npa">
  <h2>연봉 실수령액 계산</h2>
  <p class="bkc-basis">2026년 기준 · 연봉 ÷ 12개월 → 4대보험·소득세 공제 후 월 실수령액</p>
  <div class="bkc-grid">
    <label>연봉(세전, 원)<input id="npa-salary" type="number" inputmode="numeric" min="0" step="1000000" value="42000000" /></label>
    <label>비과세액(월, 원)<input id="npa-taxfree" type="number" inputmode="numeric" min="0" step="10000" value="200000" /></label>
    <label>공제대상 가족 수(본인 포함)
      <select id="npa-family"><option value="1" selected>1명</option><option value="2">2명</option><option value="3">3명</option><option value="4">4명</option><option value="5">5명</option><option value="6">6명</option></select>
    </label>
    <label>8세 이상 20세 이하 자녀 수
      <select id="npa-child"><option value="0" selected>없음</option><option value="1">1명</option><option value="2">2명</option><option value="3">3명</option></select>
    </label>
  </div>
  <output id="npa-result" aria-live="polite">입력값을 기준으로 예상 실수령액을 표시합니다.</output>
  <div class="bkc-table" id="npa-table"></div>
  <p class="bkc-note">연봉을 12로 나눈 균등 월급을 가정합니다. 상여를 별도 지급하거나 연봉에 퇴직금이 포함된 계약이라면 월 수령액이 달라집니다. 성과급 지급 달에는 원천징수 소득세가 늘어날 수 있습니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { netPayBreakdown, formatKRW } from "@/lib/calc2026";
  const root = document.getElementById("c-npa");
  if (root) {
    const g = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    const salary = g("npa-salary"), taxfree = g("npa-taxfree"), family = g("npa-family"), child = g("npa-child");
    const result = document.getElementById("npa-result");
    const table = document.getElementById("npa-table");
    const render = () => {
      const annual = Number(salary?.value || 0);
      if (!result || !table) return;
      if (annual <= 0) { result.textContent = "연봉을 입력해 주세요."; table.innerHTML = ""; return; }
      const monthly = Math.round(annual / 12);
      const b = netPayBreakdown(monthly, Number(taxfree?.value || 0), Number(family?.value || 1), Number(child?.value || 0));
      result.textContent = `월 예상 실수령액: ${formatKRW(b.net)} (연 환산 ${formatKRW(b.net * 12)})`;
      table.innerHTML = `<table><tbody>
        <tr><th scope="row">월 환산 급여</th><td>${formatKRW(monthly)}</td></tr>
        <tr><th scope="row">국민연금 (4.75%)</th><td>${formatKRW(b.pension)}</td></tr>
        <tr><th scope="row">건강보험 (3.595%)</th><td>${formatKRW(b.health)}</td></tr>
        <tr><th scope="row">장기요양보험</th><td>${formatKRW(b.ltc)}</td></tr>
        <tr><th scope="row">고용보험 (0.9%)</th><td>${formatKRW(b.employment)}</td></tr>
        <tr><th scope="row">소득세·지방소득세(근사)</th><td>${formatKRW(b.incomeTax + b.localTax)}</td></tr>
        <tr><th scope="row"><strong>월 공제 합계</strong></th><td><strong>${formatKRW(b.totalDeduction)}</strong></td></tr>
      </tbody></table>`;
    };
    [salary, taxfree, family, child].forEach((el) => el?.addEventListener(el instanceof HTMLSelectElement ? "change" : "input", render));
    render();
  }
</script>
