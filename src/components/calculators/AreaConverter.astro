<section class="section bkc" id="c-ar">
  <h2>평수 ↔ 제곱미터 변환</h2>
  <p class="bkc-basis">1평 = 3.305785㎡ · 양방향 즉시 변환</p>
  <div class="bkc-grid">
    <label>평(py)<input id="ar-py" type="number" inputmode="decimal" min="0" step="0.1" value="25" /></label>
    <label>제곱미터(㎡)<input id="ar-sqm" type="number" inputmode="decimal" min="0" step="0.01" value="82.64" /></label>
  </div>
  <output id="ar-result" aria-live="polite">한쪽 값을 입력하면 자동으로 변환됩니다.</output>
  <div class="bkc-table" id="ar-table"></div>
  <p class="bkc-note">임대주택·주거급여 공고의 면적 기준은 대부분 '전용면적' ㎡ 단위입니다. 흔히 부르는 '○평형'은 공급면적 기준이라 같은 평형이라도 전용면적은 20~25%가량 작습니다. 국민주택규모(85㎡)는 약 25.7평입니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  const root = document.getElementById("c-ar");
  if (root) {
    const PY = 3.305785;
    const py = document.getElementById("ar-py") as HTMLInputElement | null;
    const sqm = document.getElementById("ar-sqm") as HTMLInputElement | null;
    const result = document.getElementById("ar-result");
    const table = document.getElementById("ar-table");
    const refs: Array<[string, number]> = [["원룸·오피스텔", 20], ["소형(59㎡ 타입)", 59], ["국민주택규모", 85], ["중대형(102㎡ 타입)", 102]];
    const show = (pyV: number, sqmV: number) => {
      if (!result || !table) return;
      result.textContent = `${pyV.toFixed(2)}평 = ${sqmV.toFixed(2)}㎡`;
      table.innerHTML = `<table><thead><tr><th scope="col">참고 면적</th><th scope="col">㎡</th><th scope="col">평</th></tr></thead><tbody>${refs
        .map(([name, m]) => `<tr><th scope="row">${name}</th><td>${m}㎡</td><td>${(m / PY).toFixed(1)}평</td></tr>`)
        .join("")}</tbody></table>`;
    };
    py?.addEventListener("input", () => {
      const v = Number(py.value || 0);
      if (sqm) sqm.value = (v * PY).toFixed(2);
      show(v, v * PY);
    });
    sqm?.addEventListener("input", () => {
      const v = Number(sqm.value || 0);
      if (py) py.value = (v / PY).toFixed(2);
      show(v / PY, v);
    });
    show(Number(py?.value || 0), Number(py?.value || 0) * PY);
  }
</script>
