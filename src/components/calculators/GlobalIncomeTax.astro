<section class="section bkc" id="c-git">
  <h2>종합소득세 간편 계산</h2>
  <p class="bkc-basis">기본세율 6~45%(8구간) · 지방소득세 10% 별도</p>
  <div class="bkc-grid">
    <label>종합소득금액(원)<input id="git-income" type="number" inputmode="numeric" min="0" step="100000" value="40000000" /></label>
    <label>소득공제 합계(원)<input id="git-deduct" type="number" inputmode="numeric" min="0" step="100000" value="1500000" /></label>
    <label>세액공제·감면 합계(원)<input id="git-credit" type="number" inputmode="numeric" min="0" step="10000" value="70000" /></label>
  </div>
  <output id="git-result" aria-live="polite">입력값을 기준으로 세액을 표시합니다.</output>
  <div class="bkc-table" id="git-table"></div>
  <p class="bkc-note">종합소득금액은 수입금액에서 필요경비를 뺀 금액입니다. 소득공제 기본값은 본인 기본공제 150만 원, 세액공제 기본값은 표준세액공제 7만 원입니다. 이미 낸 원천징수세액(3.3% 등)과 중간예납세액은 결정세액에서 추가로 차감됩니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { basicIncomeTax, formatKRW } from "@/lib/calc2026";
  const root = document.getElementById("c-git");
  if (root) {
    const g = (id: string) => document.getElementById(id) as HTMLInputElement | null;
    const income = g("git-income"), deduct = g("git-deduct"), credit = g("git-credit");
    const result = document.getElementById("git-result");
    const table = document.getElementById("git-table");
    const render = () => {
      if (!result || !table) return;
      const i = Number(income?.value || 0);
      if (i <= 0) { result.textContent = "종합소득금액을 입력해 주세요."; table.innerHTML = ""; return; }
      const base = Math.max(i - Number(deduct?.value || 0), 0);
      const calc = basicIncomeTax(base);
      const fin = Math.max(calc - Number(credit?.value || 0), 0);
      result.textContent = `결정세액(소득세): ${formatKRW(fin)} + 지방소득세 ${formatKRW(fin * 0.1)}`;
      table.innerHTML = `<table><tbody>
        <tr><th scope="row">과세표준</th><td>${formatKRW(base)}</td></tr>
        <tr><th scope="row">산출세액</th><td>${formatKRW(calc)}</td></tr>
        <tr><th scope="row">결정세액</th><td>${formatKRW(fin)}</td></tr>
        <tr><th scope="row">지방소득세(10%)</th><td>${formatKRW(fin * 0.1)}</td></tr>
        <tr><th scope="row">총 부담(국세+지방세)</th><td>${formatKRW(fin * 1.1)}</td></tr>
      </tbody></table>`;
    };
    [income, deduct, credit].forEach((el) => el?.addEventListener("input", render));
    render();
  }
</script>
