<section class="section bkc" id="c-ui">
  <h2>실업급여(구직급여) 계산</h2>
  <p class="bkc-basis">2026년 기준 · 1일 상한 68,100원 / 하한 66,048원 (2026.1.1 이후 이직자) · 지급액 = 평균임금 60% × 소정급여일수</p>
  <div class="bkc-grid">
    <label>퇴직 전 3개월 총급여(세전, 원)<input id="ui-wage" type="number" inputmode="numeric" min="0" step="100000" value="9000000" /></label>
    <label>해당 3개월 총 일수<input id="ui-days" type="number" inputmode="numeric" min="89" max="92" value="91" /></label>
    <label>퇴직 당시 만 나이
      <select id="ui-age"><option value="u50" selected>50세 미만</option><option value="o50">50세 이상 또는 장애인</option></select>
    </label>
    <label>고용보험 가입기간
      <select id="ui-period">
        <option value="0">1년 미만</option><option value="1" selected>1년 이상 3년 미만</option>
        <option value="2">3년 이상 5년 미만</option><option value="3">5년 이상 10년 미만</option><option value="4">10년 이상</option>
      </select>
    </label>
  </div>
  <output id="ui-result" aria-live="polite">입력값을 기준으로 예상 수급액을 표시합니다.</output>
  <div class="bkc-table" id="ui-table"></div>
  <p class="bkc-note">상한과 하한의 차이가 하루 2,052원이라 월급 수준과 관계없이 대부분 비슷한 일액을 받고, 총액은 나이·가입기간에 따른 소정급여일수(120~270일)가 좌우합니다. 수급 자격(비자발적 이직, 피보험 단위기간 180일 이상)은 별도로 충족해야 하며, 이직일 다음 날부터 12개월이 지나면 남은 급여가 소멸합니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { RATES_2026 as R, formatKRW } from "@/lib/calc2026";
  const root = document.getElementById("c-ui");
  if (root) {
    const g = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    const wage = g("ui-wage"), days = g("ui-days"), age = g("ui-age"), period = g("ui-period");
    const result = document.getElementById("ui-result");
    const table = document.getElementById("ui-table");
    const DAYS: Record<string, number[]> = { u50: [120, 150, 180, 210, 240], o50: [120, 180, 210, 240, 270] };
    const render = () => {
      if (!result || !table) return;
      const w = Number(wage?.value || 0);
      const d = Number(days?.value || 91);
      if (w <= 0) { result.textContent = "퇴직 전 3개월 총급여를 입력해 주세요."; table.innerHTML = ""; return; }
      const raw = (w / d) * 0.6;
      const daily = Math.min(Math.max(raw, R.uiDailyMin), R.uiDailyMax);
      const sodang = DAYS[age?.value ?? "u50"][Number(period?.value || 0)];
      const clampNote = raw < R.uiDailyMin
        ? `산정액 ${formatKRW(raw)}이 하한 미만이라 하한액이 적용됩니다.`
        : raw > R.uiDailyMax
          ? `산정액 ${formatKRW(raw)}이 상한 초과라 상한액이 적용됩니다.`
          : "산정액이 상·하한 범위 안에 있습니다.";
      result.textContent = `총 예상 수급액: ${formatKRW(daily * sodang)} (1일 ${formatKRW(daily)} × ${sodang}일)`;
      table.innerHTML = `<table><tbody>
        <tr><th scope="row">1일 평균임금 × 60%</th><td>${formatKRW(raw)}</td></tr>
        <tr><th scope="row">적용 일액</th><td>${formatKRW(daily)} — ${clampNote}</td></tr>
        <tr><th scope="row">소정급여일수</th><td>${sodang}일</td></tr>
        <tr><th scope="row">월 환산(30일)</th><td>${formatKRW(daily * 30)}</td></tr>
      </tbody></table>`;
    };
    [wage, days, age, period].forEach((el) => el?.addEventListener(el instanceof HTMLSelectElement ? "change" : "input", render));
    render();
  }
</script>
