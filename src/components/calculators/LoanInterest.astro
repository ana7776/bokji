<section class="section bkc" id="c-ln">
  <h2>대출 이자 계산</h2>
  <p class="bkc-basis">원리금균등·원금균등·만기일시 3가지 상환 방식 비교</p>
  <div class="bkc-grid">
    <label>대출 금액(원)<input id="ln-amount" type="number" inputmode="numeric" min="0" step="1000000" value="30000000" /></label>
    <label>연 금리(%)<input id="ln-rate" type="number" inputmode="decimal" min="0" step="0.01" value="5.0" /></label>
    <label>대출 기간(개월)<input id="ln-months" type="number" inputmode="numeric" min="1" max="480" value="36" /></label>
    <label>상환 방식
      <select id="ln-type">
        <option value="amort" selected>원리금균등상환</option>
        <option value="equal">원금균등상환</option>
        <option value="bullet">만기일시상환</option>
      </select>
    </label>
  </div>
  <output id="ln-result" aria-live="polite">입력값을 기준으로 상환액을 표시합니다.</output>
  <div class="bkc-table" id="ln-table"></div>
  <p class="bkc-note">원리금균등은 매달 같은 금액을, 원금균등은 첫 달이 가장 많고 점점 줄어드는 금액을, 만기일시는 이자만 내다 만기에 원금을 갚습니다. 총이자는 만기일시 &gt; 원리금균등 &gt; 원금균등 순으로 큽니다. 중도상환수수료와 인지세는 포함되지 않았습니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { formatKRW } from "@/lib/calc2026";
  const root = document.getElementById("c-ln");
  if (root) {
    const g = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    const amount = g("ln-amount"), rate = g("ln-rate"), months = g("ln-months"), type = g("ln-type");
    const result = document.getElementById("ln-result");
    const table = document.getElementById("ln-table");
    const render = () => {
      if (!result || !table) return;
      const a = Number(amount?.value || 0);
      const yr = Number(rate?.value || 0) / 100;
      const n = Number(months?.value || 0);
      if (a <= 0 || yr <= 0 || n <= 0) { result.textContent = "금액·금리·기간을 입력해 주세요."; table.innerHTML = ""; return; }
      const r = yr / 12;
      let first = 0, last = 0, totalInt = 0, label = "";
      const t = type?.value ?? "amort";
      if (t === "amort") {
        const pmt = a * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
        first = pmt; last = pmt; totalInt = pmt * n - a; label = "매월 납입액";
      } else if (t === "equal") {
        const principal = a / n;
        first = principal + a * r;
        last = principal + principal * r;
        totalInt = a * r * (n + 1) / 2;
        label = "첫 달 → 마지막 달 납입액";
      } else {
        first = a * r; last = a * r + a; totalInt = a * r * n; label = "매월 이자 (만기에 원금 상환)";
      }
      result.textContent = t === "equal"
        ? `${label}: ${formatKRW(first)} → ${formatKRW(last)}`
        : `${label}: ${formatKRW(first)}`;
      table.innerHTML = `<table><tbody>
        <tr><th scope="row">총 이자</th><td>${formatKRW(totalInt)}</td></tr>
        <tr><th scope="row">총 상환액</th><td>${formatKRW(a + totalInt)}</td></tr>
        <tr><th scope="row">원금 대비 이자 비율</th><td>${(totalInt / a * 100).toFixed(1)}%</td></tr>
      </tbody></table>`;
    };
    [amount, rate, months].forEach((el) => el?.addEventListener("input", render));
    type?.addEventListener("change", render);
    render();
  }
</script>
