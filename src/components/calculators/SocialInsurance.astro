<section class="section bkc" id="c-si">
  <h2>4대보험료 계산 (근로자·사업주 부담 구분)</h2>
  <p class="bkc-basis">2026년 기준 · 국민연금 9.5% · 건강보험 7.19% · 장기요양 0.9448% · 고용보험 실업급여분 각 0.9%</p>
  <div class="bkc-grid">
    <label>월 보수액(비과세 제외, 원)<input id="si-pay" type="number" inputmode="numeric" min="0" step="10000" value="3000000" /></label>
    <label>기업 규모(고용안정·직능개발 요율)
      <select id="si-size">
        <option value="0.0025" selected>150인 미만 (0.25%)</option>
        <option value="0.0045">150인 이상 우선지원대상기업 (0.45%)</option>
        <option value="0.0065">150~999인 (0.65%)</option>
        <option value="0.0085">1,000인 이상·국가/지자체 (0.85%)</option>
      </select>
    </label>
  </div>
  <output id="si-result" aria-live="polite">입력값을 기준으로 보험료를 표시합니다.</output>
  <div class="bkc-table" id="si-table"></div>
  <p class="bkc-note">국민연금은 기준소득월액 하한 41만 원·상한 659만 원(2026.7~2027.6)이 적용됩니다. 산재보험은 업종별 요율이 달라 표에서 제외했으며 전액 사업주가 부담합니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { RATES_2026 as R, floor10, formatKRW } from "@/lib/calc2026";
  const root = document.getElementById("c-si");
  if (root) {
    const pay = document.getElementById("si-pay") as HTMLInputElement | null;
    const size = document.getElementById("si-size") as HTMLSelectElement | null;
    const result = document.getElementById("si-result");
    const table = document.getElementById("si-table");
    const render = () => {
      const p = Number(pay?.value || 0);
      if (!result || !table) return;
      if (p <= 0) { result.textContent = "월 보수액을 입력해 주세요."; table.innerHTML = ""; return; }
      const esRate = Number(size?.value || 0.0025);
      const npBase = Math.min(Math.max(p, R.pensionBaseMin), R.pensionBaseMax);
      const npW = floor10(npBase * R.pensionTotal / 2);
      const hiW = floor10(p * R.healthTotal / 2);
      const ltW = floor10(hiW * R.ltcRatio);
      const eiW = floor10(p * R.employmentWorker);
      const eiE = eiW + floor10(p * esRate);
      const wSum = npW + hiW + ltW + eiW;
      const eSum = npW + hiW + ltW + eiE;
      result.textContent = `근로자 부담 합계: ${formatKRW(wSum)} / 사업주 부담 합계(산재 제외): ${formatKRW(eSum)}`;
      table.innerHTML = `<table><thead><tr><th scope="col">항목</th><th scope="col">근로자</th><th scope="col">사업주</th><th scope="col">합계</th></tr></thead><tbody>
        <tr><th scope="row">국민연금</th><td>${formatKRW(npW)}</td><td>${formatKRW(npW)}</td><td>${formatKRW(npW * 2)}</td></tr>
        <tr><th scope="row">건강보험</th><td>${formatKRW(hiW)}</td><td>${formatKRW(hiW)}</td><td>${formatKRW(hiW * 2)}</td></tr>
        <tr><th scope="row">장기요양보험</th><td>${formatKRW(ltW)}</td><td>${formatKRW(ltW)}</td><td>${formatKRW(ltW * 2)}</td></tr>
        <tr><th scope="row">고용보험</th><td>${formatKRW(eiW)}</td><td>${formatKRW(eiE)}</td><td>${formatKRW(eiW + eiE)}</td></tr>
      </tbody></table>`;
    };
    pay?.addEventListener("input", render);
    size?.addEventListener("change", render);
    render();
  }
</script>
