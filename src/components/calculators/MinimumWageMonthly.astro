<section class="section bkc" id="c-mw">
  <h2>최저시급 월급 환산 (2026)</h2>
  <p class="bkc-basis">2026년 최저시급 10,320원 · 월 환산 기준 209시간(주 40시간 + 주휴 8시간)</p>
  <div class="bkc-grid">
    <label>시급(원)<input id="mw-hourly" type="number" inputmode="numeric" min="0" step="10" value="10320" /></label>
    <label>주 소정근로시간(시간)<input id="mw-hours" type="number" inputmode="decimal" min="1" max="40" step="0.5" value="40" /></label>
  </div>
  <output id="mw-result" aria-live="polite">입력값을 기준으로 월급을 표시합니다.</output>
  <div class="bkc-table" id="mw-table"></div>
  <p class="bkc-note">주 40시간 기준 2026년 최저 월급은 10,320원 × 209시간 = 2,156,880원입니다. 주 40시간은 고시의 월 209시간을 적용합니다. 그 외 시간은 연평균 주수를 이용한 간편 환산입니다. 주휴수당은 주 15시간 이상 및 소정근로일 개근 등 요건 충족을 가정하며, 실제 근로계약·근무일정에 따라 달라질 수 있습니다.</p>
  <p><a href="https://www.moel.go.kr/news/enews/report/enewsView.do?news_seq=18144" rel="noopener noreferrer">고용노동부 2026년 최저임금 확정·고시</a> · 자료 확인 2026-10-19</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { formatKRW, RATES_2026 as R } from "@/lib/calc2026";
  const root = document.getElementById("c-mw");
  if (root) {
    const hourly = document.getElementById("mw-hourly") as HTMLInputElement | null;
    const hours = document.getElementById("mw-hours") as HTMLInputElement | null;
    const result = document.getElementById("mw-result");
    const table = document.getElementById("mw-table");
    const render = () => {
      if (!result || !table) return;
      const h = Number(hourly?.value || 0);
      const t = Number(hours?.value || 0);
      if (!Number.isFinite(h) || !Number.isFinite(t) || h <= 0 || t <= 0 || t > 40) { result.textContent = "양수 시급과 0시간 초과·40시간 이하의 주 소정근로시간을 입력해 주세요."; table.innerHTML = ""; return; }
      const withHoliday = t >= 15;
      const weeklyHours = withHoliday ? t + 8 * (t / 40) : t;
      const monthlyHours = t === 40 ? 209 : weeklyHours * (365 / 7 / 12);
      const monthly = h * monthlyHours;
      const belowMin = h < R.minimumWage;
      result.textContent = `월급 환산액: ${formatKRW(monthly)}${belowMin ? " — 입력 시급이 2026년 최저시급(10,320원)보다 낮습니다." : ""}`;
      table.innerHTML = `<table><tbody>
        <tr><th scope="row">월 환산 시간</th><td>약 ${monthlyHours.toFixed(1)}시간${withHoliday ? " (주휴 포함)" : " (주휴 미적용)"}</td></tr>
        <tr><th scope="row">주급</th><td>${formatKRW(h * weeklyHours)}</td></tr>
        <tr><th scope="row">연 환산</th><td>${formatKRW(monthly * 12)}</td></tr>
        <tr><th scope="row">2026 최저 월급(주 40시간)</th><td>2,156,880원</td></tr>
      </tbody></table>`;
    };
    [hourly, hours].forEach((el) => el?.addEventListener("input", render));
    render();
  }
</script>
