<section class="section bkc" id="c-vat">
  <h2>부가가치세 계산</h2>
  <p class="bkc-basis">일반과세 10% · 공급가액 → 부가세 또는 합계금액 → 공급가액 역산</p>
  <div class="bkc-grid">
    <label>계산 방식
      <select id="vat-mode">
        <option value="supply" selected>공급가액으로 부가세 구하기</option>
        <option value="total">합계금액(부가세 포함)에서 역산</option>
      </select>
    </label>
    <label>금액(원)<input id="vat-amount" type="number" inputmode="numeric" min="0" step="10000" value="1000000" /></label>
  </div>
  <output id="vat-result" aria-live="polite">입력값을 기준으로 부가세를 표시합니다.</output>
  <div class="bkc-table" id="vat-table"></div>
  <p class="bkc-note">일반과세자 기준 10% 단일세율입니다. 간이과세자는 업종별 부가가치율을 곱해 실제 납부세율이 1.5~4% 수준으로 낮아지고, 연 매출 4,800만 원 미만 간이과세자는 납부 의무가 면제됩니다. 매입세액공제에 따라 실제 납부액은 달라집니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { formatKRW } from "@/lib/calc2026";
  const root = document.getElementById("c-vat");
  if (root) {
    const mode = document.getElementById("vat-mode") as HTMLSelectElement | null;
    const amount = document.getElementById("vat-amount") as HTMLInputElement | null;
    const result = document.getElementById("vat-result");
    const table = document.getElementById("vat-table");
    const render = () => {
      if (!result || !table) return;
      const a = Number(amount?.value || 0);
      if (a <= 0) { result.textContent = "금액을 입력해 주세요."; table.innerHTML = ""; return; }
      let supply: number, vat: number;
      if (mode?.value === "total") { supply = Math.round(a / 1.1); vat = a - supply; }
      else { supply = a; vat = Math.round(a * 0.1); }
      result.textContent = mode?.value === "total" ? `공급가액: ${formatKRW(supply)}` : `부가세: ${formatKRW(vat)}`;
      table.innerHTML = `<table><tbody>
        <tr><th scope="row">공급가액</th><td>${formatKRW(supply)}</td></tr>
        <tr><th scope="row">부가가치세(10%)</th><td>${formatKRW(vat)}</td></tr>
        <tr><th scope="row">합계금액</th><td>${formatKRW(supply + vat)}</td></tr>
      </tbody></table>`;
    };
    amount?.addEventListener("input", render);
    mode?.addEventListener("change", render);
    render();
  }
</script>
