<section class="section bkc" id="c-sv2">
  <h2>적금 이자 계산</h2>
  <p class="bkc-basis">매월 일정액을 납입하는 정기적금 기준(월초 납입 단리) · 이자소득세 15.4% 반영</p>
  <div class="bkc-grid">
    <label>월 납입액(원)<input id="sv2-amount" type="number" inputmode="numeric" min="0" step="10000" value="300000" /></label>
    <label>연 이율(%)<input id="sv2-rate" type="number" inputmode="decimal" min="0" step="0.01" value="3.5" /></label>
    <label>납입 기간(개월)<input id="sv2-months" type="number" inputmode="numeric" min="1" max="60" value="12" /></label>
    <label>과세 구분
      <select id="sv2-tax"><option value="0.154" selected>일반과세 15.4%</option><option value="0.095">세금우대 9.5%</option><option value="0">비과세</option></select>
    </label>
  </div>
  <output id="sv2-result" aria-live="polite">입력값을 기준으로 이자를 표시합니다.</output>
  <div class="bkc-table" id="sv2-table"></div>
  <p class="bkc-note">적금은 첫 달 납입금만 전체 기간의 이자를 받고 마지막 달 납입금은 한 달치만 받기 때문에, 같은 금리라도 체감 수익이 예금의 절반 수준입니다. 예를 들어 연 3.5% 12개월 적금의 실효수익률은 원금 대비 약 1.9%입니다.</p>
  <p class="bkc-warning">본 계산기는 실제 심사 결과와 다를 수 있습니다.</p>
</section>
<script>
  import { formatKRW } from "@/lib/calc2026";
  const root = document.getElementById("c-sv2");
  if (root) {
    const g = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
    const amount = g("sv2-amount"), rate = g("sv2-rate"), months = g("sv2-months"), tax = g("sv2-tax");
    const result = document.getElementById("sv2-result");
    const table = document.getElementById("sv2-table");
    const render = () => {
      if (!result || !table) return;
      const a = Number(amount?.value || 0);
      const r = Number(rate?.value || 0) / 100;
      const n = Number(months?.value || 0);
      if (a <= 0 || r <= 0 || n <= 0) { result.textContent = "납입액·이율·기간을 입력해 주세요."; table.innerHTML = ""; return; }
      const principal = a * n;
      const gross = a * (r / 12) * (n * (n + 1) / 2);
      const taxAmt = gross * Number(tax?.value || 0);
      const net = gross - taxAmt;
      result.textContent = `세후 이자: ${formatKRW(net)} / 만기 수령액: ${formatKRW(principal + net)}`;
      table.innerHTML = `<table><tbody>
        <tr><th scope="row">납입 원금</th><td>${formatKRW(principal)}</td></tr>
        <tr><th scope="row">세전 이자</th><td>${formatKRW(gross)}</td></tr>
        <tr><th scope="row">이자 과세</th><td>${formatKRW(taxAmt)}</td></tr>
        <tr><th scope="row">만기 수령액</th><td>${formatKRW(principal + net)}</td></tr>
        <tr><th scope="row">원금 대비 실효수익률</th><td>${(net / principal * 100).toFixed(2)}%</td></tr>
      </tbody></table>`;
    };
    [amount, rate, months].forEach((el) => el?.addEventListener("input", render));
    tax?.addEventListener("change", render);
    render();
  }
</script>
